  +v8 = I.addc(a3, b3, v6)
  +v9 = (a4 + b4 + v8 : U32)
  +v10 = I.addc(a4, b4, v8)
  +v11 = (a5 + b5 + v10 : U32)
  +v12 = I.addc(a5, b5, v10)
  +v13 = (a6 + b6 + v12 : U32)
  +v14 = I.addc(a6, b6, v12)
  +v15 = (a7 + b7 + v14 : U32)
  +v16 = I.addc(a7, b7, v14)
  +v17 = (v1 - 1 - 0 : U32)
  +v18 = I.subb(v1, 1, 0)
  +v19 = (v3 - 2569875693 - v18 : U32)
  +v20 = I.subb(v3, 2569875693, v18)
  +v21 = (v5 - 156039451 - v20 : U32)
  +v22 = I.subb(v5, 156039451, v20)
  +v23 = (v7 - 575052028 - v22 : U32)
  +v24 = I.subb(v7, 575052028, v22)
  +v25 = (v9 - 0 - v24 : U32)
  +v26 = I.subb(v9, 0, v24)
  +v27 = (v11 - 0 - v26 : U32)
  +v28 = I.subb(v11, 0, v26)
  +v29 = (v13 - 0 - v28 : U32)
  +v30 = I.subb(v13, 0, v28)
  +v31 = (v15 - 1073741824 - v30 : U32)
  +v32 = I.subb(v15, 1073741824, v30)
  +v33 = (v32 .&. (1 - v16) : U32)
