def add(a: Fp, b: Fp) -> Fp:
  Fp{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7} = a
  Fp{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7} = b
