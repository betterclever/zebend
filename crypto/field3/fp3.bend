  +v2 = U32.add_hi(a0, b0)
  +v3 = (a1 + b1 + v2 : U32)
  +v4 = I.addc(a1, b1, v2)
  +v5 = (a2 + b2 + v4 : U32)
  +v6 = I.addc(a2, b2, v4)
