def fp_all() -> Acc:
  fp_chunk9(fp_chunk8(fp_chunk7(fp_chunk6(fp_chunk5(fp_chunk4(fp_chunk3(fp_chunk2(fp_chunk1(fp_chunk0(Acc{0, 0, 0, 0, 0, 0, 0, 0, 0}))))))))))

def fq_one(+x: Fq.Fq, +y: Fq.Fq, +ox: OFq.Fq, +oy: OFq.Fq, a: Acc) -> Acc:
  +m = Fq.to_words(Fq.mul(x, y))
  +q = Fq.to_words(Fq.sqr(x))
  +ad = Fq.to_words(Fq.add(x, y))
  +sb = Fq.to_words(Fq.sub(x, y))
  +lz = Fq.to_words(Fq.mul(Fq.add_nr(x, y), y))
  +a1 = mix(a, m, Wd.is_eq(m, OFq.to_words(OFq.mul(ox, oy))))
  +a2 = mix(a1, q, Bool.and(Wd.is_eq(q, OFq.to_words(OFq.sqr(ox))), Wd.is_eq(q, Fq.to_words(Fq.mul(x, x)))))
  +a3 = mix(a2, ad, Wd.is_eq(ad, OFq.to_words(OFq.add(ox, oy))))
  +a4 = mix(a3, sb, Wd.is_eq(sb, OFq.to_words(OFq.sub(ox, oy))))
  mix(a4, lz, Wd.is_eq(lz, Fq.to_words(Fq.mul(Fq.add(x, y), y))))

def fq_pair(+wx: Wd.W, +wy: Wd.W, a: Acc) -> Acc:
  fq_one(Fq.from_words(wx), Fq.from_words(wy), OFq.from_words(wx), OFq.from_words(wy), a)

