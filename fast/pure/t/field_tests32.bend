# Fq inv 1
def t115() -> Bool:
  Wd.is_eq(Fq.to_words(Fq.inv(Fq.one())), Wd.W{1, 0, 0, 0, 0, 0, 0, 0})

def line(b: Bool, name: String) -> String:
  match b:
    case True{}:
      "ok   " ++ name
    case False{}:
      "FAIL " ++ name

