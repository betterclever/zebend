def lem_negsq(+bp: Nat, +l1: L.Le(1n, bp), +y: Nat, +l_y: L.Le(y, bp)) -> {T.fmul(bp, T.fneg(bp, y), T.fneg(bp, y)) == T.fmul(bp, y, y) : Nat}:
