def chord_on_k1() -> X.E:
  chord_on_n_6()

def chord_on_k2() -> X.E:
  chord_on_n_15()

def chord_on_lt() -> X.E:
  chord_on_n_8()

def chord_on_rt() -> X.E:
  chord_on_n_17()

def chord_on_el() -> {chord_on_lt() == R.lhs(chord_on_t1(), chord_on_cs(), chord_on_rs(), chord_on_k1()) : X.E}:
  {==}

def chord_on_er() -> {chord_on_rt() == R.rhs(chord_on_t2(), chord_on_cs(), chord_on_rs(), chord_on_k2()) : X.E}:
  {==}

def chord_on_hn(+bp: Nat, +env: +List<Nat>) -> {X.nv(bp, env, chord_on_lt()) == X.nv(bp, env, chord_on_rt()) : Nat}:
  Equal.trans(Nat, X.nv(bp, env, chord_on_lt()), P.evp(chord_on_n_8_w(), bp <> env), X.nv(bp, env, chord_on_rt()), chord_on_n_8_ok(bp, env), Equal.trans(Nat, P.evp(chord_on_n_8_w(), bp <> env), P.evp(chord_on_n_17_w(), bp <> env), X.nv(bp, env, chord_on_rt()), Equal.cong(+List<P.Tm>, Nat, w => P.evp(w, bp <> env), chord_on_n_8_w(), chord_on_n_17_w(), {==}), Equal.sym(Nat, X.nv(bp, env, chord_on_rt()), P.evp(chord_on_n_17_w(), bp <> env), chord_on_n_17_ok(bp, env))))

def lem_chord_on(+bp: Nat, +l1: L.Le(1n, bp), +b: Nat, +x1: Nat, +y1: Nat, +x2: Nat, +y2: Nat, +Z1: Nat, +Z2: Nat, +di: Nat, +zi1: Nat, +zi2: Nat, +l_b: L.Le(b, bp), +l_x1: L.Le(x1, bp), +l_y1: L.Le(y1, bp), +l_x2: L.Le(x2, bp), +l_y2: L.Le(y2, bp), +l_Z1: L.Le(Z1, bp), +l_Z2: L.Le(Z2, bp), +l_di: L.Le(di, bp), +l_zi1: L.Le(zi1, bp), +l_zi2: L.Le(zi2, bp), h0: {T.fmul(bp, y1, y1) == T.fadd(bp, T.fmul(bp, x1, T.fmul(bp, x1, x1)), b) : Nat}, h1: {T.fmul(bp, y2, y2) == T.fadd(bp, T.fmul(bp, x2, T.fmul(bp, x2, x2)), b) : Nat}, h2: {T.fmul(bp, T.fsub(bp, x2, x1), di) == 1n : Nat}) -> {T.fmul(bp, T.fsub(bp, T.fmul(bp, T.fmul(bp, T.fsub(bp, y2, y1), di), T.fsub(bp, x1, T.fsub(bp, T.fsub(bp, T.fmul(bp, T.fmul(bp, T.fsub(bp, y2, y1), di), T.fmul(bp, T.fsub(bp, y2, y1), di)), x1), x2))), y1), T.fsub(bp, T.fmul(bp, T.fmul(bp, T.fsub(bp, y2, y1), di), T.fsub(bp, x1, T.fsub(bp, T.fsub(bp, T.fmul(bp, T.fmul(bp, T.fsub(bp, y2, y1), di), T.fmul(bp, T.fsub(bp, y2, y1), di)), x1), x2))), y1)) == T.fadd(bp, T.fmul(bp, T.fsub(bp, T.fsub(bp, T.fmul(bp, T.fmul(bp, T.fsub(bp, y2, y1), di), T.fmul(bp, T.fsub(bp, y2, y1), di)), x1), x2), T.fmul(bp, T.fsub(bp, T.fsub(bp, T.fmul(bp, T.fmul(bp, T.fsub(bp, y2, y1), di), T.fmul(bp, T.fsub(bp, y2, y1), di)), x1), x2), T.fsub(bp, T.fsub(bp, T.fmul(bp, T.fmul(bp, T.fsub(bp, y2, y1), di), T.fmul(bp, T.fsub(bp, y2, y1), di)), x1), x2))), b) : Nat}:
  +hc = {(l_b, (l_x1, (l_y1, (l_x2, (l_y2, (l_Z1, (l_Z2, (l_di, (l_zi1, (l_zi2, Unit{})))))))))) : X.Canon(bp, [b, x1, y1, x2, y2, Z1, Z2, di, zi1, zi2])}
  +hr = {(h0, (h1, (Equal.trans(Nat, T.fmul(bp, T.fsub(bp, x2, x1), di), 1n, Nat.mod(1n, 1n+bp), h2, Equal.sym(Nat, Nat.mod(1n, 1n+bp), 1n, one_c(bp, l1))), Unit{}))) : R.Holds(bp, [b, x1, y1, x2, y2, Z1, Z2, di, zi1, zi2], chord_on_rs())}
