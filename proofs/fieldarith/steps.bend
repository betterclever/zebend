# a value t with t + d == x + 65536 is at most 2 * 65535 + 1.
def lw(+t: Nat, +d: Nat, +x: Nat, +lx: L.Le(x, 65535n), +h: {Nat.add(t, d) == Nat.add(x, 65536n) : Nat}) -> L.Le(t, TOP(65535n)):
  H.le_trans(t, Nat.add(x, 65536n), TOP(65535n), (d, h), lxk(65535n, x, lx))

law sub_bo:
  for +x: U32
  for +p: U32
  for +e: U32
  for +lx: L.Le(U32.to_nat(x), 65535n)
  for +lp: L.Le(U32.to_nat(p), 65535n)
  for +le: L.Le(U32.to_nat(e), 1n)
  L.Le(U32.to_nat(U32.sub(1, U32.shrn(U32.sub(U32.sub(U32.add(x, 65536), p), e), 16n))), 1n)

def sub_hi(+x: U32, +p: U32, +e: U32, +lx: L.Le(U32.to_nat(x), 65535n), +lp: L.Le(U32.to_nat(p), 65535n), +le: L.Le(U32.to_nat(e), 1n)) -> L.Le(U32.to_nat(U32.shrn(U32.sub(U32.sub(U32.add(x, 65536), p), e), 16n)), 1n):
  hi1(65535n, U32.to_nat(U32.and(U32.sub(U32.sub(U32.add(x, 65536), p), e), 65535)), U32.to_nat(U32.shrn(U32.sub(U32.sub(U32.add(x, 65536), p), e), 16n)), U32.to_nat(U32.sub(U32.sub(U32.add(x, 65536), p), e)),
    UB.split16(U32.sub(U32.sub(U32.add(x, 65536), p), e)),
    lw(U32.to_nat(U32.sub(U32.sub(U32.add(x, 65536), p), e)), Nat.add(U32.to_nat(e), U32.to_nat(p)), U32.to_nat(x), lx,
      Equal.trans(Nat, Nat.add(U32.to_nat(U32.sub(U32.sub(U32.add(x, 65536), p), e)), Nat.add(U32.to_nat(e), U32.to_nat(p))), Nat.add(Nat.add(U32.to_nat(U32.sub(U32.sub(U32.add(x, 65536), p), e)), U32.to_nat(e)), U32.to_nat(p)), Nat.add(U32.to_nat(x), 65536n),
        A.ac([U32.to_nat(U32.sub(U32.sub(U32.add(x, 65536), p), e)), U32.to_nat(e), U32.to_nat(p)], A.AP{A.AV{0n}, A.AP{A.AV{1n}, A.AV{2n}}}, A.AP{A.AP{A.AV{0n}, A.AV{1n}}, A.AV{2n}}, {==}),
        tw(x, p, e, lx, lp, le))))

def sub_bo(x, p, e, lx, lp, le):
  S.one_minus_le(U32.shrn(U32.sub(U32.sub(U32.add(x, 65536), p), e), 16n), sub_hi(x, p, e, lx, lp, le))

law sub_eq:
  for +x: U32
  for +p: U32
  for +e: U32
  for +lx: L.Le(U32.to_nat(x), 65535n)
  for +lp: L.Le(U32.to_nat(p), 65535n)
  for +le: L.Le(U32.to_nat(e), 1n)
  {Nat.add(Nat.add(U32.to_nat(U32.and(U32.sub(U32.sub(U32.add(x, 65536), p), e), 65535)), U32.to_nat(p)), U32.to_nat(e)) == Nat.add(U32.to_nat(x), Nat.mul(U32.to_nat(U32.sub(1, U32.shrn(U32.sub(U32.sub(U32.add(x, 65536), p), e), 16n))), 65536n)) : Nat}

def sub_eq(x, p, e, lx, lp, le):
  ss_alg(U32.to_nat(U32.and(U32.sub(U32.sub(U32.add(x, 65536), p), e), 65535)), U32.to_nat(U32.shrn(U32.sub(U32.sub(U32.add(x, 65536), p), e), 16n)), 65536n,
    U32.to_nat(U32.sub(U32.sub(U32.add(x, 65536), p), e)), U32.to_nat(e), U32.to_nat(p), U32.to_nat(x), U32.to_nat(U32.sub(1, U32.shrn(U32.sub(U32.sub(U32.add(x, 65536), p), e), 16n))),
    UB.split16(U32.sub(U32.sub(U32.add(x, 65536), p), e)),
    tw(x, p, e, lx, lp, le),
    S.one_minus(U32.shrn(U32.sub(U32.sub(U32.add(x, 65536), p), e), 16n), sub_hi(x, p, e, lx, lp, le)))

# The first limb: w = x + 65536 - p (no borrow in).
def sub0_hi(+x: U32, +p: U32, +lx: L.Le(U32.to_nat(x), 65535n), +lp: L.Le(U32.to_nat(p), 65535n)) -> L.Le(U32.to_nat(U32.shrn(U32.sub(U32.add(x, 65536), p), 16n)), 1n):
  hi1(65535n, U32.to_nat(U32.and(U32.sub(U32.add(x, 65536), p), 65535)), U32.to_nat(U32.shrn(U32.sub(U32.add(x, 65536), p), 16n)), U32.to_nat(U32.sub(U32.add(x, 65536), p)),
    UB.split16(U32.sub(U32.add(x, 65536), p)),
    lw(U32.to_nat(U32.sub(U32.add(x, 65536), p)), U32.to_nat(p), U32.to_nat(x), lx, t2(x, p, lx, lp)))

law sub0_bo:
  for +x: U32
  for +p: U32
  for +lx: L.Le(U32.to_nat(x), 65535n)
  for +lp: L.Le(U32.to_nat(p), 65535n)
  L.Le(U32.to_nat(U32.sub(1, U32.shrn(U32.sub(U32.add(x, 65536), p), 16n))), 1n)

def sub0_bo(x, p, lx, lp):
  S.one_minus_le(U32.shrn(U32.sub(U32.add(x, 65536), p), 16n), sub0_hi(x, p, lx, lp))

law sub0_eq:
  for +x: U32
  for +p: U32
  for +lx: L.Le(U32.to_nat(x), 65535n)
  for +lp: L.Le(U32.to_nat(p), 65535n)
  {Nat.add(Nat.add(U32.to_nat(U32.and(U32.sub(U32.add(x, 65536), p), 65535)), U32.to_nat(p)), 0n) == Nat.add(U32.to_nat(x), Nat.mul(U32.to_nat(U32.sub(1, U32.shrn(U32.sub(U32.add(x, 65536), p), 16n))), 65536n)) : Nat}

def sub0_eq(x, p, lx, lp):
  ss_alg(U32.to_nat(U32.and(U32.sub(U32.add(x, 65536), p), 65535)), U32.to_nat(U32.shrn(U32.sub(U32.add(x, 65536), p), 16n)), 65536n,
    U32.to_nat(U32.sub(U32.add(x, 65536), p)), 0n, U32.to_nat(p), U32.to_nat(x), U32.to_nat(U32.sub(1, U32.shrn(U32.sub(U32.add(x, 65536), p), 16n))),
    UB.split16(U32.sub(U32.add(x, 65536), p)),
    Equal.trans(Nat, Nat.add(Nat.add(U32.to_nat(U32.sub(U32.add(x, 65536), p)), 0n), U32.to_nat(p)), Nat.add(U32.to_nat(U32.sub(U32.add(x, 65536), p)), U32.to_nat(p)), Nat.add(U32.to_nat(x), 65536n),
      Equal.cong(Nat, Nat, w => Nat.add(w, U32.to_nat(p)), Nat.add(U32.to_nat(U32.sub(U32.add(x, 65536), p)), 0n), U32.to_nat(U32.sub(U32.add(x, 65536), p)), N.add_zero_r(U32.to_nat(U32.sub(U32.add(x, 65536), p)))),
      t2(x, p, lx, lp)),
    S.one_minus(U32.shrn(U32.sub(U32.add(x, 65536), p), 16n), sub0_hi(x, p, lx, lp)))
