# --- the steps ----------------------------------------------------------------

law add0_eq:
  for +a: U32
  for +b: U32
  for +la: L.Le(U32.to_nat(a), 65535n)
  for +lb: L.Le(U32.to_nat(b), 65535n)
  {Nat.add(U32.to_nat(U32.and(U32.add(a, b), 65535)), Nat.mul(U32.to_nat(U32.shrn(U32.add(a, b), 16n)), 65536n)) == Nat.add(U32.to_nat(a), U32.to_nat(b)) : Nat}

def add0_eq(a, b, la, lb):
  Equal.trans(Nat, Nat.add(U32.to_nat(U32.and(U32.add(a, b), 65535)), Nat.mul(U32.to_nat(U32.shrn(U32.add(a, b), 16n)), 65536n)), U32.to_nat(U32.add(a, b)), Nat.add(U32.to_nat(a), U32.to_nat(b)),
    UB.split16(U32.add(a, b)),
    S.add_exact(a, b, le_m32(Nat.add(U32.to_nat(a), U32.to_nat(b)), sb2(65535n, U32.to_nat(a), U32.to_nat(b), la, lb))))

law add0_hi:
  for +a: U32
  for +b: U32
  for +la: L.Le(U32.to_nat(a), 65535n)
  for +lb: L.Le(U32.to_nat(b), 65535n)
  L.Le(U32.to_nat(U32.shrn(U32.add(a, b), 16n)), 1n)

def add0_hi(a, b, la, lb):
  hi1(65535n, U32.to_nat(U32.and(U32.add(a, b), 65535)), U32.to_nat(U32.shrn(U32.add(a, b), 16n)), Nat.add(U32.to_nat(a), U32.to_nat(b)), add0_eq(a, b, la, lb), sb2(65535n, U32.to_nat(a), U32.to_nat(b), la, lb))

