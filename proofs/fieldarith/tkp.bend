# One limb step of zcash/halo2/lib/fp.bend's add, on values. Limbs are 16-bit values
# held in U32s; every U32 operation below is exact (no 2^32 wrap), which these laws
# prove from the limb bounds.
#
#   add:  v = a + b + c;           lo = v & 65535;  hi = v >> 16     lo + hi*2^16 == a + b + c
#   sub:  w = x + 65536 - p - e;   lo = w & 65535;  e' = 1 - (w >> 16)   lo + p + e == x + e'*2^16

def TOP(+m: Nat) -> Nat:
  Nat.add(Nat.add(m, m), 1n)

