import Base
import ./natlemmas.bend as N

# GENERATED by gen_wordadd.py.

def bv(b: Bool) -> Nat:
  match b:
    case False{}:
      0n
    case True{}:
      1n

def pow2(n: Nat) -> Nat:
  match n:
    case 0n:
      1n
    case 1n+p:
      Nat.double(pow2(p))

# k * 2^n for a carry bit k.
def kt(+n: Nat, b: Bool) -> Nat:
  match b:
    case False{}:
      0n
    case True{}:
      pow2(n)

# The carry bit of a full adder (the second component of Bool.full_add).
def fk(a: Bool, +b: Bool, +c: Bool) -> Bool:
  match a:
    case False{}:
      Bool.and(b, c)
    case True{}:
      Bool.or(b, c)

# The carry out of Word.adc(n, a, b, False, c): the bit Word.add drops.
def wcarry(n: Nat, a: Word(n), b: Word(n), c: Bool) -> Bool:
  match n:
    case 0n:
      c
    case 1n+p:
      match a b:
        case WCon{ab, at} WCon{bb, bt}:
          wcarry(p, at, bt, fk(ab, bb, c))

law dk:
  for -p: Nat
  for k: Bool
  {Nat.double(kt(p, k)) == kt(1n+p, k) : Nat}

def dk(p, k):
  match k:
    case False{}:
      {==}
    case True{}:
      {==}

law assoc_r:
  for +x: Nat
  for +y: Nat
  for +z: Nat
  {Nat.add(x, Nat.add(y, z)) == Nat.add(Nat.add(x, y), z) : Nat}

def assoc_r(x, y, z):
  Equal.sym(Nat, Nat.add(Nat.add(x, y), z), Nat.add(x, Nat.add(y, z)), N.add_assoc(x, y, z))

law double_add_r:
  for +x: Nat
  for +y: Nat
  {Nat.add(Nat.double(x), Nat.double(y)) == Nat.double(Nat.add(x, y)) : Nat}

def double_add_r(x, y):
  Equal.sym(Nat, Nat.double(Nat.add(x, y)), Nat.add(Nat.double(x), Nat.double(y)), N.double_add(x, y))

# One bit position of the induction, as pure Nat algebra.
