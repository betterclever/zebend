# Word.add is binary addition: the sum's value plus the dropped carry times 2^n
# equals a + b + carry-in. (U32 is Word(32), so this covers every U32 `+`.)
law adc_ok:
  for +n: Nat
  for +a: Word(n)
  for +b: Word(n)
  for +c: Bool
  {Nat.add(Word.to_nat(n, Word.adc(n, a, b, False{}, c)), kt(n, wcarry(n, a, b, c))) == Nat.add(Nat.add(Word.to_nat(n, a), Word.to_nat(n, b)), bv(c)) : Nat}

