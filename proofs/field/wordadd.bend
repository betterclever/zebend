def u32carry(x: U32, y: U32) -> Bool:
  match x y:
    case U32{a} U32{b}:
      wcarry(32n, a, b, False{})

# Corollary for U32: x + y as Bend computes it, plus the dropped carry times 2^32,
# is the true sum. So a U32 `+` is exact whenever the true sum is below 2^32.
law u32_add_ok:
  for +x: U32
  for +y: U32
  {Nat.add(U32.to_nat(U32.add(x, y)), kt(32n, u32carry(x, y))) == Nat.add(U32.to_nat(x), U32.to_nat(y)) : Nat}

def u32_add_ok(x, y):
  match x y:
    case U32{a} U32{b}:
      %N.add_zero_r(Nat.add(Word.to_nat(32n, a), Word.to_nat(32n, b))) : {Nat.add(Word.to_nat(32n, Word.add(32n, a, b)), kt(32n, wcarry(32n, a, b, False{}))) == _ : Nat}
      adc_ok(32n, a, b, False{})
