# The field's limb layer is lossless: for every 256-bit input w (8 little-endian
# words), Fp.raw splits it into 16 limbs and Fp.unraw reassembles exactly w.
law raw_roundtrip:
  for w: Wd.W
  {Fp.unraw(Fp.raw(w)) == w : Wd.W}

def raw_roundtrip(w):
  match w:
    case Wd.W{a, b, c, d, e, f, g, h}:
      %split32(a) : {Fp.unraw(Fp.raw(Wd.W{a, b, c, d, e, f, g, h})) == Wd.W{_, b, c, d, e, f, g, h} : Wd.W}
      %split32(b) : {Fp.unraw(Fp.raw(Wd.W{a, b, c, d, e, f, g, h})) == Wd.W{U32.or(U32.and(a, 65535), U32.shln(U32.shrn(a, 16n), 16n)), _, c, d, e, f, g, h} : Wd.W}
      %split32(c) : {Fp.unraw(Fp.raw(Wd.W{a, b, c, d, e, f, g, h})) == Wd.W{U32.or(U32.and(a, 65535), U32.shln(U32.shrn(a, 16n), 16n)), U32.or(U32.and(b, 65535), U32.shln(U32.shrn(b, 16n), 16n)), _, d, e, f, g, h} : Wd.W}
