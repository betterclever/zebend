      %split32(e) : {Fp.unraw(Fp.raw(Wd.W{a, b, c, d, e, f, g, h})) == Wd.W{U32.or(U32.and(a, 65535), U32.shln(U32.shrn(a, 16n), 16n)), U32.or(U32.and(b, 65535), U32.shln(U32.shrn(b, 16n), 16n)), U32.or(U32.and(c, 65535), U32.shln(U32.shrn(c, 16n), 16n)), U32.or(U32.and(d, 65535), U32.shln(U32.shrn(d, 16n), 16n)), _, f, g, h} : Wd.W}
