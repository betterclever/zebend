import Base
import ../field/natlemmas.bend as N
import ../prims/natlib.bend as L
import ../opt_gates/term.bend as T
import ./expr.bend as X
import ./poly.bend as P

# Identities in Z/p modulo hypotheses, checked by normalising Nat polynomials.
#
# To prove ev(t1) == ev(t2) in Z/p from hypotheses ev(a_j) == ev(b_j) (j = 1..k), a
# certificate gives Nat polynomials c_1..c_k, K1, K2 (as expressions) such that
#
#   nv(t1) + sum_j c_j * nv(b_j) + K1 * p  ==  nv(t2) + sum_j c_j * nv(a_j) + K2 * p
#
# holds as an identity of Nat polynomials in the variables and bp (p = 1 + bp). The checker
# decides that identity by comparing normal forms (P.nf), and cert_ok turns it into the
# Z/p equality: mod p, the K terms vanish, the two sums agree by the hypotheses, and what
# is left cancels. A certificate exists exactly when t1 - t2 lies in the ideal generated by
# the a_j - b_j over the integers; gen.py (in each law directory) finds it with sympy.

type Rel is Data:
  Rel{a: X.E, b: X.E}

def Holds(+bp: Nat, +env: +List<Nat>, rs: +List<Rel>) -> Data:
  match rs:
    case Nil{}:
      Unit
    case Con{Rel{+a, +b}, t}:
      Sigma<&2, &2, {X.ev(bp, env, a) == X.ev(bp, env, b) : Nat}, _ => Holds(bp, env, t)>

def suma(cs: +List<X.E>, rs: +List<Rel>) -> X.E:
  match cs rs:
    case Con{c, ct} Con{Rel{a, _}, rt}:
      X.Ad{X.Ml{c, a}, suma(ct, rt)}
    case _ _:
      X.C{0n}

def sumb(cs: +List<X.E>, rs: +List<Rel>) -> X.E:
  match cs rs:
    case Con{c, ct} Con{Rel{_, b}, rt}:
      X.Ad{X.Ml{c, b}, sumb(ct, rt)}
    case _ _:
      X.C{0n}

def lhs(t1: X.E, +cs: +List<X.E>, +rs: +List<Rel>, k1: X.E) -> X.E:
  X.Ad{X.Ad{t1, sumb(cs, rs)}, X.Ml{k1, X.Ad{X.C{1n}, X.Pp{}}}}

def rhs(t2: X.E, +cs: +List<X.E>, +rs: +List<Rel>, k2: X.E) -> X.E:
  X.Ad{X.Ad{t2, suma(cs, rs)}, X.Ml{k2, X.Ad{X.C{1n}, X.Pp{}}}}

# --- congruence mod p --------------------------------------------------------------------

def madd_cong(+bp: Nat, +x: Nat, +x2: Nat, +y: Nat, +y2: Nat, hx: {Nat.mod(x, 1n+bp) == Nat.mod(x2, 1n+bp) : Nat}, hy: {Nat.mod(y, 1n+bp) == Nat.mod(y2, 1n+bp) : Nat}) -> {Nat.mod(Nat.add(x, y), 1n+bp) == Nat.mod(Nat.add(x2, y2), 1n+bp) : Nat}:
  +m = {1n+bp : Nat}
  Equal.trans(Nat, Nat.mod(Nat.add(x, y), m), Nat.mod(Nat.add(Nat.mod(x, m), Nat.mod(y, m)), m), Nat.mod(Nat.add(x2, y2), m),
    Equal.sym(Nat, Nat.mod(Nat.add(Nat.mod(x, m), Nat.mod(y, m)), m), Nat.mod(Nat.add(x, y), m), Equal.trans(Nat, Nat.mod(Nat.add(Nat.mod(x, m), Nat.mod(y, m)), m), Nat.mod(Nat.add(x, Nat.mod(y, m)), m), Nat.mod(Nat.add(x, y), m), L.mod_add_mod_l(x, Nat.mod(y, m), bp), L.mod_add_mod_r(x, y, bp))),
  Equal.trans(Nat, Nat.mod(Nat.add(Nat.mod(x, m), Nat.mod(y, m)), m), Nat.mod(Nat.add(Nat.mod(x2, m), Nat.mod(y2, m)), m), Nat.mod(Nat.add(x2, y2), m),
    Equal.cong(Nat, Nat, w => Nat.mod(w, m), Nat.add(Nat.mod(x, m), Nat.mod(y, m)), Nat.add(Nat.mod(x2, m), Nat.mod(y2, m)), P.add_cong(Nat.mod(x, m), Nat.mod(x2, m), Nat.mod(y, m), Nat.mod(y2, m), hx, hy)),
    Equal.trans(Nat, Nat.mod(Nat.add(Nat.mod(x2, m), Nat.mod(y2, m)), m), Nat.mod(Nat.add(x2, Nat.mod(y2, m)), m), Nat.mod(Nat.add(x2, y2), m), L.mod_add_mod_l(x2, Nat.mod(y2, m), bp), L.mod_add_mod_r(x2, y2, bp))))

def mmul_cong(+bp: Nat, +x: Nat, +x2: Nat, +y: Nat, +y2: Nat, hx: {Nat.mod(x, 1n+bp) == Nat.mod(x2, 1n+bp) : Nat}, hy: {Nat.mod(y, 1n+bp) == Nat.mod(y2, 1n+bp) : Nat}) -> {Nat.mod(Nat.mul(x, y), 1n+bp) == Nat.mod(Nat.mul(x2, y2), 1n+bp) : Nat}:
  +m = {1n+bp : Nat}
  Equal.trans(Nat, Nat.mod(Nat.mul(x, y), m), Nat.mod(Nat.mul(Nat.mod(x, m), Nat.mod(y, m)), m), Nat.mod(Nat.mul(x2, y2), m),
    Equal.sym(Nat, Nat.mod(Nat.mul(Nat.mod(x, m), Nat.mod(y, m)), m), Nat.mod(Nat.mul(x, y), m), Equal.trans(Nat, Nat.mod(Nat.mul(Nat.mod(x, m), Nat.mod(y, m)), m), Nat.mod(Nat.mul(x, Nat.mod(y, m)), m), Nat.mod(Nat.mul(x, y), m), L.mod_mul_mod_l(x, Nat.mod(y, m), bp), L.mod_mul_mod_r(x, y, bp))),
  Equal.trans(Nat, Nat.mod(Nat.mul(Nat.mod(x, m), Nat.mod(y, m)), m), Nat.mod(Nat.mul(Nat.mod(x2, m), Nat.mod(y2, m)), m), Nat.mod(Nat.mul(x2, y2), m),
    Equal.cong(Nat, Nat, w => Nat.mod(w, m), Nat.mul(Nat.mod(x, m), Nat.mod(y, m)), Nat.mul(Nat.mod(x2, m), Nat.mod(y2, m)), P.mul_cong(Nat.mod(x, m), Nat.mod(x2, m), Nat.mod(y, m), Nat.mod(y2, m), hx, hy)),
    Equal.trans(Nat, Nat.mod(Nat.mul(Nat.mod(x2, m), Nat.mod(y2, m)), m), Nat.mod(Nat.mul(x2, Nat.mod(y2, m)), m), Nat.mod(Nat.mul(x2, y2), m), L.mod_mul_mod_l(x2, Nat.mod(y2, m), bp), L.mod_mul_mod_r(x2, y2, bp))))

# mod(x) == mod(mod(x + r) + (p - r)) for r <= bp
def shift(+bp: Nat, +x: Nat, +r: Nat, l: L.Le(r, bp)) -> {Nat.mod(x, 1n+bp) == Nat.mod(Nat.add(Nat.mod(Nat.add(x, r), 1n+bp), Nat.sub(1n+bp, r)), 1n+bp) : Nat}:
  +m = {1n+bp : Nat}
  Equal.trans(Nat, Nat.mod(x, m), Nat.mod(Nat.add(x, m), m), Nat.mod(Nat.add(Nat.mod(Nat.add(x, r), m), Nat.sub(m, r)), m),
    Equal.sym(Nat, Nat.mod(Nat.add(x, m), m), Nat.mod(x, m), L.mod_add_self(x, bp)),
  Equal.trans(Nat, Nat.mod(Nat.add(x, m), m), Nat.mod(Nat.add(x, Nat.add(r, Nat.sub(m, r))), m), Nat.mod(Nat.add(Nat.mod(Nat.add(x, r), m), Nat.sub(m, r)), m),
    Equal.cong(Nat, Nat, w => Nat.mod(Nat.add(x, w), m), m, Nat.add(r, Nat.sub(m, r)), Equal.sym(Nat, Nat.add(r, Nat.sub(m, r)), m, L.sub_add(m, r, X.le_succ(r, bp, l)))),
  Equal.trans(Nat, Nat.mod(Nat.add(x, Nat.add(r, Nat.sub(m, r))), m), Nat.mod(Nat.add(Nat.add(x, r), Nat.sub(m, r)), m), Nat.mod(Nat.add(Nat.mod(Nat.add(x, r), m), Nat.sub(m, r)), m),
    Equal.cong(Nat, Nat, w => Nat.mod(w, m), Nat.add(x, Nat.add(r, Nat.sub(m, r))), Nat.add(Nat.add(x, r), Nat.sub(m, r)), Equal.sym(Nat, Nat.add(Nat.add(x, r), Nat.sub(m, r)), Nat.add(x, Nat.add(r, Nat.sub(m, r))), N.add_assoc(x, r, Nat.sub(m, r)))),
    Equal.sym(Nat, Nat.mod(Nat.add(Nat.mod(Nat.add(x, r), m), Nat.sub(m, r)), m), Nat.mod(Nat.add(Nat.add(x, r), Nat.sub(m, r)), m), L.mod_add_mod_l(Nat.add(x, r), Nat.sub(m, r), bp)))))

# mod(x + s) == mod(y + s)  ==>  mod(x) == mod(y)
def mcancel(+bp: Nat, +x: Nat, +y: Nat, +s: Nat, h: {Nat.mod(Nat.add(x, s), 1n+bp) == Nat.mod(Nat.add(y, s), 1n+bp) : Nat}) -> {Nat.mod(x, 1n+bp) == Nat.mod(y, 1n+bp) : Nat}:
  +m = {1n+bp : Nat}
  +r = Nat.mod(s, m)
  +hr = Equal.trans(Nat, Nat.mod(Nat.add(x, r), m), Nat.mod(Nat.add(x, s), m), Nat.mod(Nat.add(y, r), m), L.mod_add_mod_r(x, s, bp), Equal.trans(Nat, Nat.mod(Nat.add(x, s), m), Nat.mod(Nat.add(y, s), m), Nat.mod(Nat.add(y, r), m), h, Equal.sym(Nat, Nat.mod(Nat.add(y, r), m), Nat.mod(Nat.add(y, s), m), L.mod_add_mod_r(y, s, bp))))
  Equal.trans(Nat, Nat.mod(x, m), Nat.mod(Nat.add(Nat.mod(Nat.add(x, r), m), Nat.sub(m, r)), m), Nat.mod(y, m),
    shift(bp, x, r, L.mod_le(s, bp)),
  Equal.trans(Nat, Nat.mod(Nat.add(Nat.mod(Nat.add(x, r), m), Nat.sub(m, r)), m), Nat.mod(Nat.add(Nat.mod(Nat.add(y, r), m), Nat.sub(m, r)), m), Nat.mod(y, m),
    Equal.cong(Nat, Nat, w => Nat.mod(Nat.add(w, Nat.sub(m, r)), m), Nat.mod(Nat.add(x, r), m), Nat.mod(Nat.add(y, r), m), hr),
    Equal.sym(Nat, Nat.mod(y, m), Nat.mod(Nat.add(Nat.mod(Nat.add(y, r), m), Nat.sub(m, r)), m), shift(bp, y, r, L.mod_le(s, bp)))))

# --- the certificate lemma -----------------------------------------------------------------

def nv_cong(+bp: Nat, +env: +List<Nat>, +hc: X.Canon(bp, env), +a: X.E, +b: X.E, h: {X.ev(bp, env, a) == X.ev(bp, env, b) : Nat}) -> {Nat.mod(X.nv(bp, env, a), 1n+bp) == Nat.mod(X.nv(bp, env, b), 1n+bp) : Nat}:
  Equal.trans(Nat, Nat.mod(X.nv(bp, env, a), 1n+bp), X.ev(bp, env, a), Nat.mod(X.nv(bp, env, b), 1n+bp), Equal.sym(Nat, X.ev(bp, env, a), Nat.mod(X.nv(bp, env, a), 1n+bp), X.ev_nv(bp, env, hc, a)), Equal.trans(Nat, X.ev(bp, env, a), X.ev(bp, env, b), Nat.mod(X.nv(bp, env, b), 1n+bp), h, X.ev_nv(bp, env, hc, b)))

def sum_cong(+bp: Nat, +env: +List<Nat>, +hc: X.Canon(bp, env), +cs: +List<X.E>, +rs: +List<Rel>, +hr: Holds(bp, env, rs)) -> {Nat.mod(X.nv(bp, env, suma(cs, rs)), 1n+bp) == Nat.mod(X.nv(bp, env, sumb(cs, rs)), 1n+bp) : Nat}:
  match cs rs:
    case Con{+c, +ct} Con{Rel{+a, +b}, +rt}:
      (+ha, +ht) = hr
      madd_cong(bp, Nat.mul(X.nv(bp, env, c), X.nv(bp, env, a)), Nat.mul(X.nv(bp, env, c), X.nv(bp, env, b)), X.nv(bp, env, suma(ct, rt)), X.nv(bp, env, sumb(ct, rt)),
        mmul_cong(bp, X.nv(bp, env, c), X.nv(bp, env, c), X.nv(bp, env, a), X.nv(bp, env, b), {==}, nv_cong(bp, env, hc, a, b, ha)),
        sum_cong(bp, env, hc, ct, rt, ht))
    case Con{_, _} Nil{}:
      {==}
    case Nil{} _:
      {==}

law cert_ok:
  for +bp: Nat
  for +env: +List<Nat>
  for +hc: X.Canon(bp, env)
  for +t1: X.E
  for +t2: X.E
  for +cs: +List<X.E>
  for +rs: +List<Rel>
  for +k1: X.E
  for +k2: X.E
  for +hr: Holds(bp, env, rs)
  for h: {P.nf(lhs(t1, cs, rs, k1)) == P.nf(rhs(t2, cs, rs, k2)) : +List<P.Tm>}
  {X.ev(bp, env, t1) == X.ev(bp, env, t2) : Nat}

def cert_ok(bp, env, hc, t1, t2, cs, rs, k1, k2, hr, h):
  +m = {1n+bp : Nat}
  +n1 = X.nv(bp, env, t1)
  +n2 = X.nv(bp, env, t2)
  +sa = X.nv(bp, env, suma(cs, rs))
  +sb = X.nv(bp, env, sumb(cs, rs))
  +q1 = X.nv(bp, env, k1)
  +q2 = X.nv(bp, env, k2)
  # the Nat identity
  +hn = Equal.trans(Nat, X.nv(bp, env, lhs(t1, cs, rs, k1)), P.evp(P.nf(lhs(t1, cs, rs, k1)), bp <> env), X.nv(bp, env, rhs(t2, cs, rs, k2)), P.nf_ok(bp, env, lhs(t1, cs, rs, k1)), Equal.trans(Nat, P.evp(P.nf(lhs(t1, cs, rs, k1)), bp <> env), P.evp(P.nf(rhs(t2, cs, rs, k2)), bp <> env), X.nv(bp, env, rhs(t2, cs, rs, k2)), Equal.cong(+List<P.Tm>, Nat, w => P.evp(w, bp <> env), P.nf(lhs(t1, cs, rs, k1)), P.nf(rhs(t2, cs, rs, k2)), h), Equal.sym(Nat, X.nv(bp, env, rhs(t2, cs, rs, k2)), P.evp(P.nf(rhs(t2, cs, rs, k2)), bp <> env), P.nf_ok(bp, env, rhs(t2, cs, rs, k2)))))
  # mod p: the K terms vanish
  +hm = Equal.trans(Nat, Nat.mod(Nat.add(n1, sb), m), Nat.mod(Nat.add(Nat.add(n1, sb), Nat.mul(q1, m)), m), Nat.mod(Nat.add(n2, sa), m), Equal.sym(Nat, Nat.mod(Nat.add(Nat.add(n1, sb), Nat.mul(q1, m)), m), Nat.mod(Nat.add(n1, sb), m), L.mod_add_mul(Nat.add(n1, sb), q1, bp)), Equal.trans(Nat, Nat.mod(Nat.add(Nat.add(n1, sb), Nat.mul(q1, m)), m), Nat.mod(Nat.add(Nat.add(n2, sa), Nat.mul(q2, m)), m), Nat.mod(Nat.add(n2, sa), m), Equal.cong(Nat, Nat, w => Nat.mod(w, m), Nat.add(Nat.add(n1, sb), Nat.mul(q1, m)), Nat.add(Nat.add(n2, sa), Nat.mul(q2, m)), hn), L.mod_add_mul(Nat.add(n2, sa), q2, bp)))
  # the sums agree by the hypotheses
  +hs = Equal.trans(Nat, Nat.mod(Nat.add(n1, sb), m), Nat.mod(Nat.add(n2, sa), m), Nat.mod(Nat.add(n2, sb), m), hm, madd_cong(bp, n2, n2, sa, sb, {==}, sum_cong(bp, env, hc, cs, rs, hr)))
  # cancel, and read back in Z/p
  Equal.trans(Nat, X.ev(bp, env, t1), Nat.mod(n1, m), X.ev(bp, env, t2), X.ev_nv(bp, env, hc, t1), Equal.trans(Nat, Nat.mod(n1, m), Nat.mod(n2, m), X.ev(bp, env, t2), mcancel(bp, n1, n2, sb, hs), Equal.sym(Nat, X.ev(bp, env, t2), Nat.mod(n2, m), X.ev_nv(bp, env, hc, t2))))

# cert_ok with the two sides given as expressions lt, rt that unfold to lhs(..) and rhs(..):
# their normal forms can then be computed in steps (certgen.py's checkpoints).
law cert_ok2:
  for +bp: Nat
  for +env: +List<Nat>
  for +hc: X.Canon(bp, env)
  for +t1: X.E
  for +t2: X.E
  for +cs: +List<X.E>
  for +rs: +List<Rel>
  for +k1: X.E
  for +k2: X.E
  for +hr: Holds(bp, env, rs)
  for +lt: X.E
  for +rt: X.E
  for el: {lt == lhs(t1, cs, rs, k1) : X.E}
  for er: {rt == rhs(t2, cs, rs, k2) : X.E}
  for h: {P.nf(lt) == P.nf(rt) : +List<P.Tm>}
  {X.ev(bp, env, t1) == X.ev(bp, env, t2) : Nat}

def cert_ok2(bp, env, hc, t1, t2, cs, rs, k1, k2, hr, lt, rt, el, er, h):
  cert_ok(bp, env, hc, t1, t2, cs, rs, k1, k2, hr, Equal.trans(+List<P.Tm>, P.nf(lhs(t1, cs, rs, k1)), P.nf(lt), P.nf(rhs(t2, cs, rs, k2)), Equal.cong(X.E, +List<P.Tm>, w => P.nf(w), lhs(t1, cs, rs, k1), lt, Equal.sym(X.E, lt, lhs(t1, cs, rs, k1), el)), Equal.trans(+List<P.Tm>, P.nf(lt), P.nf(rt), P.nf(rhs(t2, cs, rs, k2)), h, Equal.cong(X.E, +List<P.Tm>, w => P.nf(w), rt, rhs(t2, cs, rs, k2), er))))
