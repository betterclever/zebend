import Base
import ./model.bend as M
import ./red.bend as R
import ./fill.bend as F
import ./win.bend as W
import ./digit.bend as D
import ./LAWS.bend as Laws

def Laws.window_ok(half, rf, ps, us, j, hw, hn):
  F.window_ok(half, rf, ps, us, j, hw, hn)

def Laws.msm9_ok(cm, ps, us, cnt, hw, hn, hf):
  Equal.trans(Nat, M.msm9(cm, ps, us, cnt), M.spec(1n+cm, Nat.pow(2n, cm), ps, us, cnt, 0n), D.coef(Nat.pow(2n, 1n+cm), Nat.pow(2n, cm), ps, us, cnt, 0n), W.wrange_ok(9n, False{}, 1n+cm, Nat.pow(2n, cm), 32n, ps, us, 0n, cnt, hf, hw, hn), D.spec_coef(1n+cm, Nat.pow(2n, cm), ps, us, cnt, 0n))

def Laws.recode(B, half, u, cnt, lo):
  D.recode(B, half, u, cnt, lo)

def zrow_ok(+half: Nat, +n: Nat) -> M.Win1(half, M.zrow(n)):
  match n:
    case 0n:
      Unit{}
    case 1n+k:
      ((Nat.add(half, half), {==}), zrow_ok(half, k))

def Laws.win_sat(half, np, nw):
  match np:
    case 0n:
      Unit{}
    case 1n+k:
      (zrow_ok(half, nw), Laws.win_sat(half, k, nw))

def pow2_step(+j: Nat, +h: M.Le(1n, Nat.pow(2n, j))) -> M.Le(1n, Nat.pow(2n, 1n+j)):
  (e, he) = h
  +X = Nat.add(Nat.pow(2n, j), 0n)
  (Nat.add(e, X), Equal.cong(Nat, Nat, w => Nat.add(w, X), 1n+e, Nat.pow(2n, j), he))

def pow2_pos(+k: Nat) -> M.Le(1n, Nat.pow(2n, k)):
  match k:
    case 0n:
      (0n, {==})
    case 1n+j:
      pow2_step(j, pow2_pos(j))

def Laws.points_sat(a, rf):
  pow2_pos(rf)

