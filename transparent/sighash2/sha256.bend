def big_s0(+a: U32) -> U32:
  (((a >> 2n) .|. (a << 30n)) .^. ((a >> 13n) .|. (a << 19n)) .^. ((a >> 22n) .|. (a << 10n)) : U32)

def big_s1(+e: U32) -> U32:
  (((e >> 6n) .|. (e << 26n)) .^. ((e >> 11n) .|. (e << 21n)) .^. ((e >> 25n) .|. (e << 7n)) : U32)

def small_s0(+x: U32) -> U32:
