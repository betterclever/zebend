def rmd_fin(h: RS, l: RS, r: RS) -> RS:
  RS{+h0, +h1, +h2, +h3, +h4} = h
  RS{al, bl, cl, dl, el} = l
  RS{ar, br, cr, dr, er} = r
  RS{(h1 + cl + dr : U32), (h2 + dl + er : U32), (h3 + el + ar : U32), (h4 + al + br : U32), (h0 + bl + cr : U32)}

def rmd_compress(+h: RS, +m: M16) -> RS:
  rmd_fin(h, rmd_left(h, m), rmd_right(h, m))

def drop(xs: +List<U32>, n: Nat) -> +List<U32>:
  match xs n:
    case Nil{} _:
      Nil{}
    case Con{h, t} 0n:
      h <> t
    case Con{_, t} 1n+p:
      drop(t, p)

def append(xs: +List<U32>, ys: +List<U32>) -> +List<U32>:
  match xs:
    case Nil{}:
      ys
    case Con{h, t}:
      h <> append(t, ys)

def zeros(n: Nat) -> +List<U32>:
  match n:
    case 0n:
      Nil{}
    case 1n+p:
      0 <> zeros(p)

def len_go(xs: +List<U32>, +acc: U32) -> U32:
  match xs:
    case Nil{}:
      acc
    case Con{_, t}:
      len_go(t, (acc + 1 : U32))

def le_word(xs: +List<U32>) -> U32:
  match xs:
    case Con{a, Con{b, Con{c, Con{d, _}}}}:
      (a .|. (b << 8n) .|. (c << 16n) .|. (d << 24n) : U32)
    case _:
      0

def be_word(xs: +List<U32>) -> U32:
  match xs:
    case Con{a, Con{b, Con{c, Con{d, _}}}}:
      ((a << 24n) .|. (b << 16n) .|. (c << 8n) .|. d : U32)
    case _:
      0

def m16(le: Bool, +xs: +List<U32>) -> M16:
  match le:
    case True{}:
      M16{le_word(xs), le_word(drop(xs, 4n)), le_word(drop(xs, 8n)), le_word(drop(xs, 12n)),
          le_word(drop(xs, 16n)), le_word(drop(xs, 20n)), le_word(drop(xs, 24n)), le_word(drop(xs, 28n)),
          le_word(drop(xs, 32n)), le_word(drop(xs, 36n)), le_word(drop(xs, 40n)), le_word(drop(xs, 44n)),
          le_word(drop(xs, 48n)), le_word(drop(xs, 52n)), le_word(drop(xs, 56n)), le_word(drop(xs, 60n))}
    case False{}:
      M16{be_word(xs), be_word(drop(xs, 4n)), be_word(drop(xs, 8n)), be_word(drop(xs, 12n)),
          be_word(drop(xs, 16n)), be_word(drop(xs, 20n)), be_word(drop(xs, 24n)), be_word(drop(xs, 28n)),
          be_word(drop(xs, 32n)), be_word(drop(xs, 36n)), be_word(drop(xs, 40n)), be_word(drop(xs, 44n)),
          be_word(drop(xs, 48n)), be_word(drop(xs, 52n)), be_word(drop(xs, 56n)), be_word(drop(xs, 60n))}

def le4(+w: U32, acc: +List<U32>) -> +List<U32>:
  (w .&. 255 : U32) <> ((w >> 8n) .&. 255 : U32) <> ((w >> 16n) .&. 255 : U32) <> (w >> 24n : U32) <> acc

def be4(+w: U32, acc: +List<U32>) -> +List<U32>:
  (w >> 24n : U32) <> ((w >> 16n) .&. 255 : U32) <> ((w >> 8n) .&. 255 : U32) <> (w .&. 255 : U32) <> acc

# 0x80, zeros to 56 mod 64, then the 64-bit bit length (little- or big-endian).
def pad(le: Bool, +xs: +List<U32>, +len: U32) -> +List<U32>:
  +zs = ((119 - (len .&. 63)) .&. 63 : U32)
  +lo = (len << 3n : U32)
  +hi = (len >> 29n : U32)
  append(xs, 128 <> append(zeros(U32.to_nat(zs)), Bool.pick(+List<U32>, le, le4(lo, le4(hi, Nil{})), be4(hi, be4(lo, Nil{})))))

def comp(rmd: Bool, +h: RS, +xs: +List<U32>) -> RS:
  match rmd:
    case True{}:
      rmd_compress(h, m16(True{}, xs))
    case False{}:
      sha1_compress(h, m16(False{}, xs))

def blocks(n: Nat, +rmd: Bool, +xs: +List<U32>, +h: RS) -> RS:
  match n:
    case 0n:
      h
    case 1n+p:
      blocks(p, rmd, drop(xs, 64n), comp(rmd, h, xs))

def rmd_iv() -> RS:
  RS{1732584193, 4023233417, 2562383102, 271733878, 3285377520}

def rmd_out(h: RS) -> +List<U32>:
  RS{a, b, c, d, e} = h
  le4(a, le4(b, le4(c, le4(d, le4(e, Nil{})))))

def sha1_out(h: RS) -> +List<U32>:
  RS{a, b, c, d, e} = h
  be4(a, be4(b, be4(c, be4(d, be4(e, Nil{})))))

def ripemd160(+xs: +List<U32>) -> +List<U32>:
  +len = len_go(xs, 0)
  rmd_out(blocks(U32.to_nat(((len + 72) >> 6n : U32)), True{}, pad(True{}, xs, len), rmd_iv()))

def sha1(+xs: +List<U32>) -> +List<U32>:
  +len = len_go(xs, 0)
  sha1_out(blocks(U32.to_nat(((len + 72) >> 6n : U32)), False{}, pad(False{}, xs, len), rmd_iv()))
