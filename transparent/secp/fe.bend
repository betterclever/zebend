# p - b for b <= p.
def p_minus(b: Fe) -> Fe:
  Fe{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7} = b
  +v1 = U32.mac64(0, U32.not(b0), U32.not(b1), 1, 0, 4294966319, 4294967294, 1, 0)
  +v2 = U32.mac64(1, U32.not(b0), U32.not(b1), 1, 0, 4294966319, 4294967294, 1, 0)
  +v3 = U32.mac64(2, U32.not(b0), U32.not(b1), 1, 0, 4294966319, 4294967294, 1, 0)
  +v4 = U32.mac64(3, U32.not(b0), U32.not(b1), 1, 0, 4294966319, 4294967294, 1, 0)
  +v5 = U32.mac64(0, U32.not(b2), U32.not(b3), 1, 0, 4294967295, 4294967295, v3, v4)
  +v6 = U32.mac64(1, U32.not(b2), U32.not(b3), 1, 0, 4294967295, 4294967295, v3, v4)
  +v7 = U32.mac64(2, U32.not(b2), U32.not(b3), 1, 0, 4294967295, 4294967295, v3, v4)
  +v8 = U32.mac64(3, U32.not(b2), U32.not(b3), 1, 0, 4294967295, 4294967295, v3, v4)
  +v9 = U32.mac64(0, U32.not(b4), U32.not(b5), 1, 0, 4294967295, 4294967295, v7, v8)
  +v10 = U32.mac64(1, U32.not(b4), U32.not(b5), 1, 0, 4294967295, 4294967295, v7, v8)
  +v11 = U32.mac64(2, U32.not(b4), U32.not(b5), 1, 0, 4294967295, 4294967295, v7, v8)
  +v12 = U32.mac64(3, U32.not(b4), U32.not(b5), 1, 0, 4294967295, 4294967295, v7, v8)
  +v13 = U32.mac64(0, U32.not(b6), U32.not(b7), 1, 0, 4294967295, 4294967295, v11, v12)
  +v14 = U32.mac64(1, U32.not(b6), U32.not(b7), 1, 0, 4294967295, 4294967295, v11, v12)
  +v15 = U32.mac64(2, U32.not(b6), U32.not(b7), 1, 0, 4294967295, 4294967295, v11, v12)
  +v16 = U32.mac64(3, U32.not(b6), U32.not(b7), 1, 0, 4294967295, 4294967295, v11, v12)
  Fe{v1, v2, v5, v6, v9, v10, v13, v14}

# x mod p for any 256-bit x.
def reduce(x: Fe) -> Fe:
  Fe{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7} = x
  +v1 = U32.mac64(0, x0, x1, 1, 0, 977, 1, 0, 0)
  +v2 = U32.mac64(1, x0, x1, 1, 0, 977, 1, 0, 0)
  +v3 = U32.mac64(2, x0, x1, 1, 0, 977, 1, 0, 0)
  +v4 = U32.mac64(3, x0, x1, 1, 0, 977, 1, 0, 0)
  +v5 = U32.mac64(0, x2, x3, 1, 0, 0, 0, v3, v4)
  +v6 = U32.mac64(1, x2, x3, 1, 0, 0, 0, v3, v4)
  +v7 = U32.mac64(2, x2, x3, 1, 0, 0, 0, v3, v4)
  +v8 = U32.mac64(3, x2, x3, 1, 0, 0, 0, v3, v4)
  +v9 = U32.mac64(0, x4, x5, 1, 0, 0, 0, v7, v8)
  +v10 = U32.mac64(1, x4, x5, 1, 0, 0, 0, v7, v8)
  +v11 = U32.mac64(2, x4, x5, 1, 0, 0, 0, v7, v8)
  +v12 = U32.mac64(3, x4, x5, 1, 0, 0, 0, v7, v8)
  +v13 = U32.mac64(0, x6, x7, 1, 0, 0, 0, v11, v12)
  +v14 = U32.mac64(1, x6, x7, 1, 0, 0, 0, v11, v12)
  +v15 = U32.mac64(2, x6, x7, 1, 0, 0, 0, v11, v12)
  +v16 = U32.mac64(3, x6, x7, 1, 0, 0, 0, v11, v12)
  +v17 = (0 .|. v15 : U32)
  +v18 = (0 - v17 : U32)
  +v19 = ((v1 .&. v18) .|. (x0 .&. U32.not(v18)) : U32)
  +v20 = ((v2 .&. v18) .|. (x1 .&. U32.not(v18)) : U32)
  +v21 = ((v5 .&. v18) .|. (x2 .&. U32.not(v18)) : U32)
  +v22 = ((v6 .&. v18) .|. (x3 .&. U32.not(v18)) : U32)
  +v23 = ((v9 .&. v18) .|. (x4 .&. U32.not(v18)) : U32)
  +v24 = ((v10 .&. v18) .|. (x5 .&. U32.not(v18)) : U32)
  +v25 = ((v13 .&. v18) .|. (x6 .&. U32.not(v18)) : U32)
  +v26 = ((v14 .&. v18) .|. (x7 .&. U32.not(v18)) : U32)
  Fe{v19, v20, v21, v22, v23, v24, v25, v26}

def is_canonical(x: Fe) -> Bool:
  Fe{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7} = x
  +v1 = U32.mac64(0, x0, x1, 1, 0, 977, 1, 0, 0)
  +v2 = U32.mac64(1, x0, x1, 1, 0, 977, 1, 0, 0)
  +v3 = U32.mac64(2, x0, x1, 1, 0, 977, 1, 0, 0)
  +v4 = U32.mac64(3, x0, x1, 1, 0, 977, 1, 0, 0)
  +v5 = U32.mac64(0, x2, x3, 1, 0, 0, 0, v3, v4)
  +v6 = U32.mac64(1, x2, x3, 1, 0, 0, 0, v3, v4)
  +v7 = U32.mac64(2, x2, x3, 1, 0, 0, 0, v3, v4)
  +v8 = U32.mac64(3, x2, x3, 1, 0, 0, 0, v3, v4)
  +v9 = U32.mac64(0, x4, x5, 1, 0, 0, 0, v7, v8)
  +v10 = U32.mac64(1, x4, x5, 1, 0, 0, 0, v7, v8)
  +v11 = U32.mac64(2, x4, x5, 1, 0, 0, 0, v7, v8)
  +v12 = U32.mac64(3, x4, x5, 1, 0, 0, 0, v7, v8)
  +v13 = U32.mac64(0, x6, x7, 1, 0, 0, 0, v11, v12)
  +v14 = U32.mac64(1, x6, x7, 1, 0, 0, 0, v11, v12)
  +v15 = U32.mac64(2, x6, x7, 1, 0, 0, 0, v11, v12)
  +v16 = U32.mac64(3, x6, x7, 1, 0, 0, 0, v11, v12)
  U32.is_zero(v15)

# 1
def one() -> Fe:
  Fe{1, 0, 0, 0, 0, 0, 0, 0}

# the curve constant b
def seven() -> Fe:
  Fe{7, 0, 0, 0, 0, 0, 0, 0}


def eq(a: Fe, b: Fe) -> Bool:
  Fe{a0, a1, a2, a3, a4, a5, a6, a7} = a
  Fe{b0, b1, b2, b3, b4, b5, b6, b7} = b
  U32.is_eq(a0, b0) && U32.is_eq(a1, b1) && U32.is_eq(a2, b2) && U32.is_eq(a3, b3) && U32.is_eq(a4, b4) && U32.is_eq(a5, b5) && U32.is_eq(a6, b6) && U32.is_eq(a7, b7)

def is_zero(a: Fe) -> Bool:
  Fe{a0, a1, a2, a3, a4, a5, a6, a7} = a
  U32.is_zero((a0 .|. a1 .|. a2 .|. a3 .|. a4 .|. a5 .|. a6 .|. a7 : U32))

def zero() -> Fe:
  Fe{0, 0, 0, 0, 0, 0, 0, 0}

def be_word(+xs: +List<U32>, +i: Nat) -> U32:
  match xs:
    case Con{a, Con{b, Con{c, Con{d, _}}}}:
      ((a << 24n) .|. (b << 16n) .|. (c << 8n) .|. d : U32)
    case _:
      0

def drop(xs: +List<U32>, n: Nat) -> +List<U32>:
  match xs n:
    case Nil{} _:
      Nil{}
    case Con{h, t} 0n:
      h <> t
    case Con{_, t} 1n+p:
      drop(t, p)

# 32 big-endian bytes (missing bytes read as 0) as a value (no reduction).
def from_be(+xs: +List<U32>) -> Fe:
  Fe{be_word(drop(xs, 28n), 0n), be_word(drop(xs, 24n), 0n), be_word(drop(xs, 20n), 0n), be_word(drop(xs, 16n), 0n),
      be_word(drop(xs, 12n), 0n), be_word(drop(xs, 8n), 0n), be_word(drop(xs, 4n), 0n), be_word(xs, 0n)}

def be4(+w: U32, acc: +List<U32>) -> +List<U32>:
  (w >> 24n : U32) <> ((w >> 16n) .&. 255 : U32) <> ((w >> 8n) .&. 255 : U32) <> (w .&. 255 : U32) <> acc

def to_be(a: Fe) -> +List<U32>:
  Fe{a0, a1, a2, a3, a4, a5, a6, a7} = a
  be4(a7, be4(a6, be4(a5, be4(a4, be4(a3, be4(a2, be4(a1, be4(a0, Nil{}))))))))

def low_word(a: Fe) -> U32:
  Fe{a0, _, _, _, _, _, _, _} = a
  a0

