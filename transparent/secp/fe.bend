# a + b mod p; a < p, b <= p.
def add(a: Fe, b: Fe) -> Fe:
  Fe{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7} = a
  Fe{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7} = b
  +v1 = U32.mac64(0, a0, a1, 1, 0, b0, b1, 0, 0)
