  +v14 = U32.mac64(1, a6, a7, 1, 0, b6, b7, v11, v12)
  +v15 = U32.mac64(2, a6, a7, 1, 0, b6, b7, v11, v12)
  +v16 = U32.mac64(3, a6, a7, 1, 0, b6, b7, v11, v12)
  +v17 = U32.mac64(0, v1, v2, 1, 0, 977, 1, 0, 0)
  +v18 = U32.mac64(1, v1, v2, 1, 0, 977, 1, 0, 0)
  +v19 = U32.mac64(2, v1, v2, 1, 0, 977, 1, 0, 0)
  +v20 = U32.mac64(3, v1, v2, 1, 0, 977, 1, 0, 0)
