  +v26 = U32.mac64(1, v9, v10, 1, 0, 0, 0, v23, v24)
  +v27 = U32.mac64(2, v9, v10, 1, 0, 0, 0, v23, v24)
  +v28 = U32.mac64(3, v9, v10, 1, 0, 0, 0, v23, v24)
  +v29 = U32.mac64(0, v13, v14, 1, 0, 0, 0, v27, v28)
