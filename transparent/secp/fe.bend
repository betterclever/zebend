  +v4 = U32.mac64(3, a0, a1, 1, 0, b0, b1, 0, 0)
  +v5 = U32.mac64(0, a2, a3, 1, 0, b2, b3, v3, v4)
  +v6 = U32.mac64(1, a2, a3, 1, 0, b2, b3, v3, v4)
  +v7 = U32.mac64(2, a2, a3, 1, 0, b2, b3, v3, v4)
  +v8 = U32.mac64(3, a2, a3, 1, 0, b2, b3, v3, v4)
  +v9 = U32.mac64(0, a4, a5, 1, 0, b4, b5, v7, v8)
  +v10 = U32.mac64(1, a4, a5, 1, 0, b4, b5, v7, v8)
  +v11 = U32.mac64(2, a4, a5, 1, 0, b4, b5, v7, v8)
  +v12 = U32.mac64(3, a4, a5, 1, 0, b4, b5, v7, v8)
