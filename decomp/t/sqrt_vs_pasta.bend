    case Nil{}:
      Nil{}

def fq_norm(+r: Fq.Fq) -> Fq.Fq:
  Fq.sel(Fq.low_bit(r), Fq.neg(r), r)

def fq_hash(+h: U32, m: Maybe<&2, Fq.Fq>) -> U32:
  match m:
    case Some{+r}:
      fold(h, Fq.to_words(fq_norm(r)))
    case None{}:
      xs((h .^. 2779096485 : U32))

def fq_show(m: Maybe<&2, Fq.Fq>) -> String:
  match m:
    case Some{+r}:
      Wd.hex(Fq.to_words(fq_norm(r)))
    case None{}:
      "none"

# 1 if the two results disagree (presence, or root up to sign).
def fq_diff(a: Maybe<&2, Fq.Fq>, b: Maybe<&2, Fq.Fq>) -> U32:
  match a b:
    case Some{+r} Some{+s}:
      Bool.to_u32(Bool.not(Fq.is_eq(fq_norm(r), fq_norm(s))))
    case None{} None{}:
      0
    case _ _:
      1

def fq_d1(+s: U32, +x: Fq.Fq) -> D:
  +m = QS.sqrt(x)
  +sq = Maybe.is_some(&2, Fq.Fq, m)
  D{fq_hash(s, m), fq_diff(m, Fq.sqrt(x)), Bool.to_u32(sq)}

def fq_item(+s: U32) -> D:
  +x = Fq.from_words(rw(s))
  dadd(fq_d1(s, x), fq_d1((s .^. 1 : U32), Fq.sqr(x)))

def fq_run(n: Nat, +s: U32, a: D) -> D:
  match n:
    case 0n:
      a
    case 1n+k:
      fq_run(k, next8(s), dadd(a, fq_item(s)))

def fq_par(+d: Nat, +seed: U32, +n: Nat) -> D:
  match d:
    case 0n:
      fq_run(n, (seed * 2654435761 + 777 : U32), D{0, 0, 0})
    case 1n+p:
      a b = fq_par(p, (seed * 2 : U32), n) fq_par(p, (seed * 2 + 1 : U32), n)
      dadd(a, b)

