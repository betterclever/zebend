+def mempool_call(method, params):
+    """Call the mempool process's RPC (only methods it answers itself: no forwarding loop)."""
+    if not MEMPOOL_RPC:
+        raise RpcError(-1, "no mempool (ZEBEND_MEMPOOL_RPC is empty)")
+    import urllib.request
+    req = urllib.request.Request(MEMPOOL_RPC, data=json.dumps(
+        {"jsonrpc": "1.0", "id": 1, "method": method, "params": params}).encode(),
+        headers={"Content-Type": "application/json"})
+    try:
+        r = json.load(urllib.request.urlopen(req, timeout=300))
+    except Exception as e:
+        raise RpcError(-1, f"mempool unavailable: {e.__class__.__name__}")
+    if r.get("error"):
+        raise RpcError(r["error"].get("code", -1), r["error"].get("message", "mempool error"))
+    return r["result"]
+
