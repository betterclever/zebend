+        return subprocess.run([str(exe), str(lst)], capture_output=True, text=True, timeout=HOOK_TIMEOUT)
+    except subprocess.TimeoutExpired:
+        raise VerifierError(f"hook {name}: timed out after {HOOK_TIMEOUT} s on {n_items} tx")
