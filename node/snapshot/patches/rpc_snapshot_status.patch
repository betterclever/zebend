+    def snapshot_status(self):
+        """How this instance's state started (fullnode/snapshot/README.md): a store imported from
+        a snapshot reports "snapshot-assumed" until snapshot/confirm.py has recomputed the same
+        Bend digest from the genesis instance at that height ("confirmed")."""
+        with self.lock:
+            sn = self.st.get("snapshot")
+            assumed = self.st.get("assumed_state")
+        if sn:
+            return {k: sn.get(k) for k in ("status", "height", "hash", "digest", "pinned", "provenance",
+                                           "confirmed_at", "confirmed_by")}
+        if assumed:
+            return {"status": "none", "provenance": f"oracle-assisted assumed state from {assumed.get('start')}, "
+                                                    "NOT genesis-verified"}
+        return {"status": "none", "provenance": "synced from genesis by this node"}
+
