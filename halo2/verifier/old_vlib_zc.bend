def fis_eq(a: F, b: F) -> U32:
  F{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7, +a8, +a9, +a10, +a11, +a12, +a13, +a14, +a15} = a
  F{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7, +b8, +b9, +b10, +b11, +b12, +b13, +b14, +b15} = b
  +v1 = ((a0 .^. b0) .|. (a1 .^. b1) .|. (a2 .^. b2) .|. (a3 .^. b3) .|. (a4 .^. b4) .|. (a5 .^. b5) .|. (a6 .^. b6) .|. (a7 .^. b7) .|. (a8 .^. b8) .|. (a9 .^. b9) .|. (a10 .^. b10) .|. (a11 .^. b11) .|. (a12 .^. b12) .|. (a13 .^. b13) .|. (a14 .^. b14) .|. (a15 .^. b15) : U32)
  +v2 = ((v1 .|. (0 - v1)) >> 31n : U32)
  (1 - v2 : U32)

def R2() -> F:
  F{15, 0, 60595, 35960, 57575, 35597, 3517, 55251, 23832, 50121, 43419, 30615, 46868, 31644, 16815, 2413}

def FONE() -> F:
  F{65533, 65535, 27960, 13432, 5293, 58393, 13579, 39212, 65535, 65535, 65535, 65535, 65535, 65535, 65535, 16383}

def FZERO() -> F:
