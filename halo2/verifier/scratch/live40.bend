import Base
import ../../lib/fp.bend as Fp
import ../../lib/words.bend as Wd

def g(+x: Fp.Fp) -> Fp.Fp:
  +a0 = Fp.mul(Fp.from_u32(2), Fp.from_u32(3))
  +a1 = Fp.mul(Fp.from_u32(3), Fp.from_u32(4))
  +a2 = Fp.mul(Fp.from_u32(4), Fp.from_u32(5))
  +a3 = Fp.mul(Fp.from_u32(5), Fp.from_u32(6))
  +a4 = Fp.mul(Fp.from_u32(6), Fp.from_u32(7))
  +a5 = Fp.mul(Fp.from_u32(7), Fp.from_u32(8))
  +a6 = Fp.mul(Fp.from_u32(8), Fp.from_u32(9))
  +a7 = Fp.mul(Fp.from_u32(9), Fp.from_u32(10))
  +a8 = Fp.mul(Fp.from_u32(10), Fp.from_u32(11))
  +a9 = Fp.mul(Fp.from_u32(11), Fp.from_u32(12))
  +a10 = Fp.mul(Fp.from_u32(12), Fp.from_u32(13))
  +a11 = Fp.mul(Fp.from_u32(13), Fp.from_u32(14))
  +a12 = Fp.mul(Fp.from_u32(14), Fp.from_u32(15))
  +a13 = Fp.mul(Fp.from_u32(15), Fp.from_u32(16))
  +a14 = Fp.mul(Fp.from_u32(16), Fp.from_u32(17))
  +a15 = Fp.mul(Fp.from_u32(17), Fp.from_u32(18))
  +a16 = Fp.mul(Fp.from_u32(18), Fp.from_u32(19))
  +a17 = Fp.mul(Fp.from_u32(19), Fp.from_u32(20))
  +a18 = Fp.mul(Fp.from_u32(20), Fp.from_u32(21))
  +a19 = Fp.mul(Fp.from_u32(21), Fp.from_u32(22))
  +a20 = Fp.mul(Fp.from_u32(22), Fp.from_u32(23))
  +a21 = Fp.mul(Fp.from_u32(23), Fp.from_u32(24))
  +a22 = Fp.mul(Fp.from_u32(24), Fp.from_u32(25))
  +a23 = Fp.mul(Fp.from_u32(25), Fp.from_u32(26))
  +a24 = Fp.mul(Fp.from_u32(26), Fp.from_u32(27))
  +a25 = Fp.mul(Fp.from_u32(27), Fp.from_u32(28))
  +a26 = Fp.mul(Fp.from_u32(28), Fp.from_u32(29))
  +a27 = Fp.mul(Fp.from_u32(29), Fp.from_u32(30))
  +a28 = Fp.mul(Fp.from_u32(30), Fp.from_u32(31))
  +a29 = Fp.mul(Fp.from_u32(31), Fp.from_u32(32))
  +a30 = Fp.mul(Fp.from_u32(32), Fp.from_u32(33))
  +a31 = Fp.mul(Fp.from_u32(33), Fp.from_u32(34))
  +a32 = Fp.mul(Fp.from_u32(34), Fp.from_u32(35))
  +a33 = Fp.mul(Fp.from_u32(35), Fp.from_u32(36))
  +a34 = Fp.mul(Fp.from_u32(36), Fp.from_u32(37))
  +a35 = Fp.mul(Fp.from_u32(37), Fp.from_u32(38))
  +a36 = Fp.mul(Fp.from_u32(38), Fp.from_u32(39))
  +a37 = Fp.mul(Fp.from_u32(39), Fp.from_u32(40))
  +a38 = Fp.mul(Fp.from_u32(40), Fp.from_u32(41))
  +a39 = Fp.mul(Fp.from_u32(41), Fp.from_u32(42))
  +s1 = Fp.add(a0, a1)
  +s2 = Fp.add(s1, a2)
  +s3 = Fp.add(s2, a3)
  +s4 = Fp.add(s3, a4)
  +s5 = Fp.add(s4, a5)
  +s6 = Fp.add(s5, a6)
  +s7 = Fp.add(s6, a7)
  +s8 = Fp.add(s7, a8)
  +s9 = Fp.add(s8, a9)
  +s10 = Fp.add(s9, a10)
  +s11 = Fp.add(s10, a11)
  +s12 = Fp.add(s11, a12)
  +s13 = Fp.add(s12, a13)
  +s14 = Fp.add(s13, a14)
  +s15 = Fp.add(s14, a15)
  +s16 = Fp.add(s15, a16)
  +s17 = Fp.add(s16, a17)
  +s18 = Fp.add(s17, a18)
  +s19 = Fp.add(s18, a19)
  +s20 = Fp.add(s19, a20)
  +s21 = Fp.add(s20, a21)
  +s22 = Fp.add(s21, a22)
  +s23 = Fp.add(s22, a23)
  +s24 = Fp.add(s23, a24)
  +s25 = Fp.add(s24, a25)
  +s26 = Fp.add(s25, a26)
  +s27 = Fp.add(s26, a27)
  +s28 = Fp.add(s27, a28)
  +s29 = Fp.add(s28, a29)
  +s30 = Fp.add(s29, a30)
  +s31 = Fp.add(s30, a31)
  +s32 = Fp.add(s31, a32)
  +s33 = Fp.add(s32, a33)
  +s34 = Fp.add(s33, a34)
  +s35 = Fp.add(s34, a35)
  +s36 = Fp.add(s35, a36)
  +s37 = Fp.add(s36, a37)
  +s38 = Fp.add(s37, a38)
  +s39 = Fp.add(s38, a39)
  Fp.add(s39, x)

def main() -> IO(Unit):
  +r = g(Fp.one())
  do IO<Unit>:
    IO.print(Wd.hex(Fp.to_words(r)))
