# GENERATED self-test: generated gates in Bend vs halo2's recorded values.
import Base
import ../../gpu-scan/zcrypto.bend as Z
import ./toy_cs.bend as C

def A() -> +List<Z.F>:
  {Z.F{36490, 30705, 54583, 65199, 56470, 53897, 45560, 24122, 64706, 3518, 50587, 24774, 3468, 6513, 45942, 572} : Z.F} <> {Z.F{9902, 32060, 53654, 5114, 56829, 40158, 64794, 13001, 51616, 19462, 29371, 61692, 45823, 11155, 34477, 9617} : Z.F} <> {Z.F{7776, 20558, 41977, 3788, 27418, 35526, 21509, 3664, 59507, 51672, 4861, 3199, 7323, 11415, 21688, 8106} : Z.F} <> []

def FX() -> +List<Z.F>:
  {Z.F{10129, 31315, 6171, 25403, 47107, 30961, 37697, 52493, 59285, 55512, 16671, 61977, 48389, 64943, 3747, 4092} : Z.F} <> {Z.F{21475, 5615, 45835, 7212, 29521, 1320, 55272, 6010, 31949, 18094, 36353, 11132, 29242, 37386, 12972, 11089} : Z.F} <> {Z.F{21475, 5615, 45835, 7212, 29521, 1320, 55272, 6010, 31949, 18094, 36353, 11132, 29242, 37386, 12972, 11089} : Z.F} <> []

def I() -> +List<Z.F>:
  {Z.F{30706, 65464, 5432, 5901, 25244, 56989, 50707, 8563, 4103, 43483, 27180, 61959, 40435, 63341, 60823, 11289} : Z.F} <> []

def WANT() -> +List<Z.F>:
  {Z.F{22141, 7544, 670, 53303, 63396, 4725, 49773, 29502, 51070, 41533, 65409, 45379, 25016, 47972, 52486, 8528} : Z.F} <> []

def count(+xs: +List<Z.F>, +ys: +List<Z.F>) -> U32:
  match xs ys:
    case Con{x, xt} Con{y, yt}:
      (Z.fis_eq(x, y) + count(xt, yt) : U32)
    case _ _:
      0

def main() -> IO(Unit):
  do IO<Unit>:
    +got : +List<Z.F> = C.gate_polys(A(), FX(), I())
    IO.print("gate polys matching halo2: " ++ U32.show(count(got, WANT())) ++ " / " ++ U32.show(U32.from_nat(List.length(&2, Z.F, WANT()))))
