# P 0 + p
def t128() -> Bool:
  Wd.is_eq(P.encode(P.add(P.identity(), Maybe.default(&2, P.Pt, P.decompress(Wd.W{3525898807, 2757578885, 2344977652, 3301866191, 1683871441, 1427790191, 18515346, 660880121}), P.identity()))), Wd.W{3525898807, 2757578885, 2344977652, 3301866191, 1683871441, 1427790191, 18515346, 660880121})

# P double 0
def t129() -> Bool:
  Wd.is_eq(P.encode(P.double(P.identity())), Wd.W{0, 0, 0, 0, 0, 0, 0, 0})

# P encode 0
def t130() -> Bool:
  Wd.is_eq(P.encode(P.identity()), Wd.W{0, 0, 0, 0, 0, 0, 0, 0})

# P decompress 0
def t131() -> Bool:
  P.is_identity(Maybe.default(&2, P.Pt, P.decompress(Wd.W{0, 0, 0, 0, 0, 0, 0, 0}), P.identity()))

# P scalar_mul by 0
def t132() -> Bool:
  Wd.is_eq(P.encode(P.scalar_mul(Maybe.default(&2, P.Pt, P.decompress(Wd.W{3525898807, 2757578885, 2344977652, 3301866191, 1683871441, 1427790191, 18515346, 660880121}), P.identity()), Wd.zero())), Wd.W{0, 0, 0, 0, 0, 0, 0, 0})

# P reject x=0 sign=1
def t133() -> Bool:
  Maybe.is_none(&2, P.Pt, P.decompress(Wd.W{0, 0, 0, 0, 0, 0, 0, 2147483648}))

# P reject x >= modulus
def t134() -> Bool:
  Maybe.is_none(&2, P.Pt, P.decompress(Wd.W{4294967295, 4294967295, 4294967295, 4294967295, 4294967295, 4294967295, 4294967295, 2147483647}))

# P reject off-curve x=2
def t135() -> Bool:
  Maybe.is_none(&2, P.Pt, P.decompress(Wd.W{2, 0, 0, 0, 0, 0, 0, 0}))

def line(b: Bool, name: String) -> String:
  match b:
    case True{}:
      "ok   " ++ name
    case False{}:
      "FAIL " ++ name

def main() -> IO(Unit):
  do IO<Unit>:
    IO.print(line(t0(), "V decompress/encode 0"))
    IO.print(line(t1(), "V add 0"))
