  +v21 = (v5 - 156039451 - v20 : U32)
  +v22 = I.subb(v5, 156039451, v20)
  +v23 = (v7 - 575052028 - v22 : U32)
  +v24 = I.subb(v7, 575052028, v22)
  +v25 = (v9 - 0 - v24 : U32)
  +v26 = I.subb(v9, 0, v24)
  +v27 = (v11 - 0 - v26 : U32)
  +v28 = I.subb(v11, 0, v26)
  +v29 = (v13 - 0 - v28 : U32)
  +v30 = I.subb(v13, 0, v28)
  +v31 = (v15 - 1073741824 - v30 : U32)
  +v32 = I.subb(v15, 1073741824, v30)
  +v33 = (v32 .&. (1 - v16) : U32)
  +v34 = (0 - v33 : U32)
  +v35 = (v34 .^. 4294967295 : U32)
  +v36 = ((v1 .&. v34) .|. (v17 .&. v35) : U32)
  +v37 = ((v3 .&. v34) .|. (v19 .&. v35) : U32)
  +v38 = ((v5 .&. v34) .|. (v21 .&. v35) : U32)
  +v39 = ((v7 .&. v34) .|. (v23 .&. v35) : U32)
  +v40 = ((v9 .&. v34) .|. (v25 .&. v35) : U32)
  +v41 = ((v11 .&. v34) .|. (v27 .&. v35) : U32)
  +v42 = ((v13 .&. v34) .|. (v29 .&. v35) : U32)
  +v43 = ((v15 .&. v34) .|. (v31 .&. v35) : U32)
  Fp{v36, v37, v38, v39, v40, v41, v42, v43}

# Lazy add: a + b WITHOUT the final reduction, for a, b in [0, m): the result is
# in [0, 2m), which fits 256 bits since m < 2^255. SAFE ONLY as one operand of
# `mul` whose other operand is fully reduced (< m): then a*b < 2m^2 and the
# Montgomery output stays < 2m, which mul's single conditional subtraction maps
# into [0, m). NOT safe for both mul operands (4m > 2^256 for Pasta), nor for
# to_words / eq / transcript, which need canonical inputs.
def add_nr(a: Fp, b: Fp) -> Fp:
  Fp{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7} = a
  Fp{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7} = b
  +v1 = (a0 + b0 : U32)
  +v2 = U32.add_hi(a0, b0)
  +v3 = (a1 + b1 + v2 : U32)
  +v4 = I.addc(a1, b1, v2)
  +v5 = (a2 + b2 + v4 : U32)
  +v6 = I.addc(a2, b2, v4)
  +v7 = (a3 + b3 + v6 : U32)
  +v8 = I.addc(a3, b3, v6)
  +v9 = (a4 + b4 + v8 : U32)
  +v10 = I.addc(a4, b4, v8)
  +v11 = (a5 + b5 + v10 : U32)
  +v12 = I.addc(a5, b5, v10)
  +v13 = (a6 + b6 + v12 : U32)
  +v14 = I.addc(a6, b6, v12)
  +v15 = (a7 + b7 + v14 : U32)
  +v16 = I.addc(a7, b7, v14)
  Fp{v1, v3, v5, v7, v9, v11, v13, v15}

def sub(a: Fp, b: Fp) -> Fp:
  Fp{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7} = a
  Fp{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7} = b
  +v1 = (a0 - b0 - 0 : U32)
  +v2 = I.subb(a0, b0, 0)
  +v3 = (a1 - b1 - v2 : U32)
  +v4 = I.subb(a1, b1, v2)
  +v5 = (a2 - b2 - v4 : U32)
  +v6 = I.subb(a2, b2, v4)
  +v7 = (a3 - b3 - v6 : U32)
  +v8 = I.subb(a3, b3, v6)
  +v9 = (a4 - b4 - v8 : U32)
  +v10 = I.subb(a4, b4, v8)
  +v11 = (a5 - b5 - v10 : U32)
  +v12 = I.subb(a5, b5, v10)
  +v13 = (a6 - b6 - v12 : U32)
  +v14 = I.subb(a6, b6, v12)
  +v15 = (a7 - b7 - v14 : U32)
  +v16 = I.subb(a7, b7, v14)
  +v17 = (0 - v16 : U32)
  +v18 = (1 .&. v17 : U32)
  +v19 = (v1 + v18 : U32)
  +v20 = U32.add_hi(v1, v18)
  +v21 = (2569875693 .&. v17 : U32)
  +v22 = (v3 + v21 + v20 : U32)
  +v23 = I.addc(v3, v21, v20)
  +v24 = (156039451 .&. v17 : U32)
  +v25 = (v5 + v24 + v23 : U32)
  +v26 = I.addc(v5, v24, v23)
  +v27 = (575052028 .&. v17 : U32)
  +v28 = (v7 + v27 + v26 : U32)
  +v29 = I.addc(v7, v27, v26)
  +v30 = (0 .&. v17 : U32)
  +v31 = (v9 + v30 + v29 : U32)
  +v32 = I.addc(v9, v30, v29)
  +v33 = (0 .&. v17 : U32)
  +v34 = (v11 + v33 + v32 : U32)
  +v35 = I.addc(v11, v33, v32)
  +v36 = (0 .&. v17 : U32)
  +v37 = (v13 + v36 + v35 : U32)
  +v38 = I.addc(v13, v36, v35)
  +v39 = (1073741824 .&. v17 : U32)
  +v40 = (v15 + v39 + v38 : U32)
  +v41 = I.addc(v15, v39, v38)
  Fp{v19, v22, v25, v28, v31, v34, v37, v40}

# 1 if a == b else 0 (branch-free).
def eq(a: Fp, b: Fp) -> U32:
  Fp{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7} = a
  Fp{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7} = b
  +v1 = ((a0 .^. b0) .|. (a1 .^. b1) .|. (a2 .^. b2) .|. (a3 .^. b3) .|. (a4 .^. b4) .|. (a5 .^. b5) .|. (a6 .^. b6) .|. (a7 .^. b7) : U32)
  +v2 = ((v1 .|. (0 - v1)) >> 31n : U32)
  (1 - v2 : U32)

# c == 1 selects a, c == 0 selects b (branch-free).
def sel(+c: U32, a: Fp, b: Fp) -> Fp:
  Fp{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7} = a
  Fp{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7} = b
  +mk = (0 - c : U32)
  +nm = (mk .^. 4294967295 : U32)
  +v1 = ((a0 .&. mk) .|. (b0 .&. nm) : U32)
  +v2 = ((a1 .&. mk) .|. (b1 .&. nm) : U32)
  +v3 = ((a2 .&. mk) .|. (b2 .&. nm) : U32)
  +v4 = ((a3 .&. mk) .|. (b3 .&. nm) : U32)
  +v5 = ((a4 .&. mk) .|. (b4 .&. nm) : U32)
  +v6 = ((a5 .&. mk) .|. (b5 .&. nm) : U32)
  +v7 = ((a6 .&. mk) .|. (b6 .&. nm) : U32)
  +v8 = ((a7 .&. mk) .|. (b7 .&. nm) : U32)
  Fp{v1, v2, v3, v4, v5, v6, v7, v8}

# R^2 mod m: raw -> Montgomery
def R2() -> Fp:
  Fp{15, 2356735155, 2332942567, 3620933053, 3284753688, 2006428059, 2073868052, 158155183}

def one() -> Fp:
  Fp{4294967293, 880307512, 3826848941, 2569811211, 4294967295, 4294967295, 4294967295, 1073741823}

# 5^t: a 2^32-th root of unity used by Tonelli-Shanks
def C5() -> Fp:
  Fp{3134643184, 2727196745, 3551869407, 2424556803, 2647147662, 4222007754, 2072626906, 1053370484}

def zero() -> Fp:
  Fp{0, 0, 0, 0, 0, 0, 0, 0}

# 2^256 mod m in Montgomery form (used to fold the high half of a 512-bit value).
def R256() -> Fp:
  Fp{15, 2356735155, 2332942567, 3620933053, 3284753688, 2006428059, 2073868052, 158155183}

def neg(a: Fp) -> Fp:
  sub(zero(), a)

def double(+a: Fp) -> Fp:
  add(a, a)

def sqr(+a: Fp) -> Fp:
  mul(a, a)

def sqr_n(n: Nat, x: Fp) -> Fp:
  match n:
    case 0n:
      x
    case 1n+k:
      sqr_n(k, sqr(x))





# x^(m-2) = x^-1 (x != 0); 0 -> 0
def pow_m2(x: Fp) -> Fp:
  +x0 = x
  acc0 = x0
  acc1 = mul(sqr_n(129n, acc0), x0)
  acc2 = mul(sqr_n(4n, acc1), x0)
  acc3 = mul(sqr_n(3n, acc2), x0)
  acc4 = mul(sqr_n(4n, acc3), x0)
  acc5 = mul(sqr_n(1n, acc4), x0)
  acc6 = mul(sqr_n(2n, acc5), x0)
  acc7 = mul(sqr_n(3n, acc6), x0)
  acc8 = mul(sqr_n(1n, acc7), x0)
  acc9 = mul(sqr_n(4n, acc8), x0)
  acc10 = mul(sqr_n(1n, acc9), x0)
  acc11 = mul(sqr_n(1n, acc10), x0)
  acc12 = mul(sqr_n(1n, acc11), x0)
  acc13 = mul(sqr_n(1n, acc12), x0)
  acc14 = mul(sqr_n(1n, acc13), x0)
  acc15 = mul(sqr_n(7n, acc14), x0)
  acc16 = mul(sqr_n(3n, acc15), x0)
  acc17 = mul(sqr_n(2n, acc16), x0)
  acc18 = mul(sqr_n(3n, acc17), x0)
  acc19 = mul(sqr_n(1n, acc18), x0)
  acc20 = mul(sqr_n(3n, acc19), x0)
  acc21 = mul(sqr_n(1n, acc20), x0)
  acc22 = mul(sqr_n(1n, acc21), x0)
  acc23 = mul(sqr_n(1n, acc22), x0)
  acc24 = mul(sqr_n(1n, acc23), x0)
  acc25 = mul(sqr_n(3n, acc24), x0)
  acc26 = mul(sqr_n(4n, acc25), x0)
  acc27 = mul(sqr_n(1n, acc26), x0)
  acc28 = mul(sqr_n(2n, acc27), x0)
  acc29 = mul(sqr_n(1n, acc28), x0)
  acc30 = mul(sqr_n(1n, acc29), x0)
  acc31 = mul(sqr_n(3n, acc30), x0)
  acc32 = mul(sqr_n(1n, acc31), x0)
  acc33 = mul(sqr_n(3n, acc32), x0)
  acc34 = mul(sqr_n(3n, acc33), x0)
  acc35 = mul(sqr_n(2n, acc34), x0)
  acc36 = mul(sqr_n(1n, acc35), x0)
  acc37 = mul(sqr_n(2n, acc36), x0)
  acc38 = mul(sqr_n(3n, acc37), x0)
  acc39 = mul(sqr_n(1n, acc38), x0)
  acc40 = mul(sqr_n(5n, acc39), x0)
  acc41 = mul(sqr_n(1n, acc40), x0)
  acc42 = mul(sqr_n(1n, acc41), x0)
  acc43 = mul(sqr_n(2n, acc42), x0)
  acc44 = mul(sqr_n(1n, acc43), x0)
  acc45 = mul(sqr_n(3n, acc44), x0)
  acc46 = mul(sqr_n(1n, acc45), x0)
  acc47 = mul(sqr_n(1n, acc46), x0)
  acc48 = mul(sqr_n(1n, acc47), x0)
  acc49 = mul(sqr_n(1n, acc48), x0)
  acc50 = mul(sqr_n(1n, acc49), x0)
  acc51 = mul(sqr_n(1n, acc50), x0)
  acc52 = mul(sqr_n(1n, acc51), x0)
  acc53 = mul(sqr_n(1n, acc52), x0)
  acc54 = mul(sqr_n(1n, acc53), x0)
  acc55 = mul(sqr_n(1n, acc54), x0)
  acc56 = mul(sqr_n(1n, acc55), x0)
  acc57 = mul(sqr_n(1n, acc56), x0)
  acc58 = mul(sqr_n(1n, acc57), x0)
  acc59 = mul(sqr_n(1n, acc58), x0)
  acc60 = mul(sqr_n(1n, acc59), x0)
  acc61 = mul(sqr_n(1n, acc60), x0)
  acc62 = mul(sqr_n(1n, acc61), x0)
  acc63 = mul(sqr_n(1n, acc62), x0)
  acc64 = mul(sqr_n(1n, acc63), x0)
  acc65 = mul(sqr_n(1n, acc64), x0)
  acc66 = mul(sqr_n(1n, acc65), x0)
  acc67 = mul(sqr_n(1n, acc66), x0)
  acc68 = mul(sqr_n(1n, acc67), x0)
  acc69 = mul(sqr_n(1n, acc68), x0)
  acc70 = mul(sqr_n(1n, acc69), x0)
  acc71 = mul(sqr_n(1n, acc70), x0)
  acc72 = mul(sqr_n(1n, acc71), x0)
  acc73 = mul(sqr_n(1n, acc72), x0)
  acc74 = mul(sqr_n(1n, acc73), x0)
  acc75 = mul(sqr_n(1n, acc74), x0)
  acc76 = mul(sqr_n(1n, acc75), x0)
  acc76

# x^((t-1)/2), the Tonelli-Shanks starting power
def pow_c3(x: Fp) -> Fp:
  +x0 = x
  acc0 = x0
  acc1 = mul(sqr_n(129n, acc0), x0)
  acc2 = mul(sqr_n(4n, acc1), x0)
  acc3 = mul(sqr_n(3n, acc2), x0)
  acc4 = mul(sqr_n(4n, acc3), x0)
  acc5 = mul(sqr_n(1n, acc4), x0)
  acc6 = mul(sqr_n(2n, acc5), x0)
  acc7 = mul(sqr_n(3n, acc6), x0)
  acc8 = mul(sqr_n(1n, acc7), x0)
  acc9 = mul(sqr_n(4n, acc8), x0)
  acc10 = mul(sqr_n(1n, acc9), x0)
  acc11 = mul(sqr_n(1n, acc10), x0)
  acc12 = mul(sqr_n(1n, acc11), x0)
  acc13 = mul(sqr_n(1n, acc12), x0)
  acc14 = mul(sqr_n(1n, acc13), x0)
  acc15 = mul(sqr_n(7n, acc14), x0)
  acc16 = mul(sqr_n(3n, acc15), x0)
  acc17 = mul(sqr_n(2n, acc16), x0)
  acc18 = mul(sqr_n(3n, acc17), x0)
  acc19 = mul(sqr_n(1n, acc18), x0)
  acc20 = mul(sqr_n(3n, acc19), x0)
  acc21 = mul(sqr_n(1n, acc20), x0)
  acc22 = mul(sqr_n(1n, acc21), x0)
  acc23 = mul(sqr_n(1n, acc22), x0)
  acc24 = mul(sqr_n(1n, acc23), x0)
  acc25 = mul(sqr_n(3n, acc24), x0)
  acc26 = mul(sqr_n(4n, acc25), x0)
  acc27 = mul(sqr_n(1n, acc26), x0)
  acc28 = mul(sqr_n(2n, acc27), x0)
  acc29 = mul(sqr_n(1n, acc28), x0)
  acc30 = mul(sqr_n(1n, acc29), x0)
  acc31 = mul(sqr_n(3n, acc30), x0)
  acc32 = mul(sqr_n(1n, acc31), x0)
  acc33 = mul(sqr_n(3n, acc32), x0)
  acc34 = mul(sqr_n(3n, acc33), x0)
  acc35 = mul(sqr_n(2n, acc34), x0)
  acc36 = mul(sqr_n(1n, acc35), x0)
  acc37 = mul(sqr_n(2n, acc36), x0)
  acc38 = mul(sqr_n(3n, acc37), x0)
  acc39 = mul(sqr_n(1n, acc38), x0)
  acc40 = mul(sqr_n(5n, acc39), x0)
  acc41 = mul(sqr_n(1n, acc40), x0)
  acc42 = mul(sqr_n(1n, acc41), x0)
  acc43 = mul(sqr_n(2n, acc42), x0)
  acc44 = mul(sqr_n(1n, acc43), x0)
  acc45 = sqr_n(1n, acc44)
  acc45

def is_eq(a: Fp, b: Fp) -> Bool:
  U32.is_eq(eq(a, b), 1)

def is_zero(a: Fp) -> Bool:
  U32.is_eq(eq(a, zero()), 1)

# Raw limbs of a 256-bit integer (any value < 2^256, not necessarily reduced).
def raw(w: Wd.W) -> Fp:
  Wd.W{a, b, c, d, e, f, g, h} = w
  Fp{a, b, c, d, e, f, g, h}

def unraw(a: Fp) -> Wd.W:
  Fp{a0, a1, a2, a3, a4, a5, a6, a7} = a
  Wd.W{a0, a1, a2, a3, a4, a5, a6, a7}

# Canonical (or any < 2^256) little-endian words -> element (reduced mod m).
# Montgomery REDC of raw(w) * R2 is valid for any input < 2^256 = R.
def from_words(w: Wd.W) -> Fp:
  mul(raw(w), R2())

# Element -> canonical little-endian words.
def to_words(a: Fp) -> Wd.W:
  unraw(mul(a, Fp{1, 0, 0, 0, 0, 0, 0, 0}))

# A 512-bit little-endian integer lo + 2^256 * hi, reduced mod m
# (ff's from_uniform_bytes, used by halo2's Challenge255 and hash-to-field).
def from_wide(lo: Wd.W, hi: Wd.W) -> Fp:
  add(from_words(lo), mul(from_words(hi), R256()))

def from_u32(x: U32) -> Fp:
  from_words(Wd.W{x, 0, 0, 0, 0, 0, 0, 0})

# The modulus as words.
def modulus() -> Wd.W:
  Wd.W{1, 2569875693, 156039451, 575052028, 0, 0, 0, 1073741824}

def mul_if(b: Bool, acc: Fp, +x: Fp) -> Fp:
  match b:
    case True{}:
      mul(acc, x)
    case False{}:
      acc

# acc^(2^32) * x^w, scanning the 32 bits of w from the top.
def pow_w(n: Nat, w: U32, acc: Fp, +x: Fp) -> Fp:
  match n:
    case 0n:
      acc
    case 1n+k:
      +w2 = w
      pow_w(k, (w2 << 1n : U32), mul_if(U32.is_eq((w2 >> 31n : U32), 1), sqr(acc), x), x)

# x^e for a variable 256-bit exponent e (little-endian words).
def pow(+x: Fp, e: Wd.W) -> Fp:
  Wd.W{e0, e1, e2, e3, e4, e5, e6, e7} = e
  a7 = pow_w(32n, e7, one(), x)
  a6 = pow_w(32n, e6, a7, x)
  a5 = pow_w(32n, e5, a6, x)
  a4 = pow_w(32n, e4, a5, x)
  a3 = pow_w(32n, e3, a4, x)
  a2 = pow_w(32n, e2, a3, x)
  a1 = pow_w(32n, e1, a2, x)
  pow_w(32n, e0, a1, x)

def inv(x: Fp) -> Fp:
  pow_m2(x)

# Lowest bit of the canonical value (the "sign" used by point compression).
def low_bit(a: Fp) -> U32:
  Wd.low_bit(to_words(a))

type S3 is Data:
  S3{z: Fp, t: Fp, c: Fp}

# One Tonelli-Shanks round (RFC 9380 App. I.4) after n squarings.
def ts_step(n: Nat, +z: Fp, +t: Fp, c: Fp) -> S3:
  +e = eq(sqr_n(n, t), one())
  +cc = c
  z2 = sel(e, z, mul(z, cc))
  +c2 = sqr(cc)
  t2 = sel(e, t, mul(t, c2))
  S3{z2, t2, c2}

def ts_z(s: S3) -> Fp:
  S3{z, _, _} = s
  z

def ts_loop(+n: Nat, s: S3) -> Fp:
  match n s:
    case 0n S3{z, t, c}:
      ts_z(ts_step(0n, z, t, c))
    case 1n+k S3{z, t, c}:
      ts_loop(k, ts_step(1n+k, z, t, c))

# A square root of x when x is a square (constant time; check sqr(r) == x).
# m - 1 = 2^32 * t with t odd; 5 is a non-residue.
def sqrt_cand(+x: Fp) -> Fp:
  +z0 = pow_c3(x)
  t0 = mul(sqr(z0), x)
  ts_loop(30n, S3{mul(z0, x), t0, C5()})

def maybe_if(b: Bool, r: Fp) -> Maybe<&2, Fp>:
  match b:
    case True{}:
      Some{r}
    case False{}:
      None{}

def sqrt(+x: Fp) -> Maybe<&2, Fp>:
  +r = sqrt_cand(x)
  maybe_if(is_eq(sqr(r), x), r)
