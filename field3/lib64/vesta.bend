# Vesta: y^2 = x^3 + 5 over Fq (vesta::Base); scalars in Fp (vesta::Scalar).
# Complete projective formulas (Renes-Costello-Batina 2015, a = 0, b3 = 15).
import Base
import ../../halo2/lib/words.bend as Wd
import ../fq64.bend as B
import ../fp64.bend as S

type Pt is Data:
  Pt{x: B.Fq, y: B.Fq, z: B.Fq}

type Aff is Data:
  Aff{x: B.Fq, y: B.Fq}

def identity() -> Pt:
  Pt{B.zero(), B.one(), B.zero()}

def is_identity(p: Pt) -> Bool:
  Pt{_, _, z} = p
  B.is_zero(z)

# 15 * a (b3 = 3 * b with b = 5)
def mul15(+a: B.Fq) -> B.Fq:
  +a2 = B.add(a, a)
  +a4 = B.add(a2, a2)
  +a8 = B.add(a4, a4)
  B.sub(B.add(a8, a8), a)

# RCB Algorithm 7: complete projective addition, a = 0.
def add(p: Pt, q: Pt) -> Pt:
  Pt{+x1, +y1, +z1} = p
  Pt{+x2, +y2, +z2} = q
  +t0 = B.mul(x1, x2)
  +t1 = B.mul(y1, y2)
  +t2 = B.mul(z1, z2)
  t3a = B.mul(B.add(x1, y1), B.add(x2, y2))
  +t3 = B.sub(t3a, B.add(t0, t1))
  t4a = B.mul(B.add(y1, z1), B.add(y2, z2))
  +t4 = B.sub(t4a, B.add(t1, t2))
  x3a = B.mul(B.add(x1, z1), B.add(x2, z2))
  y3a = B.sub(x3a, B.add(t0, t2))
  +t0b = B.add(B.add(t0, t0), t0)
  +t2b = mul15(t2)
  +z3a = B.add(t1, t2b)
  +t1b = B.sub(t1, t2b)
  +y3b = mul15(y3a)
  x3 = B.sub(B.mul(t3, t1b), B.mul(t4, y3b))
  y3 = B.add(B.mul(t1b, z3a), B.mul(y3b, t0b))
  z3 = B.add(B.mul(z3a, t4), B.mul(t0b, t3))
  Pt{x3, y3, z3}

# RCB Algorithm 8: mixed addition P + Q with Q affine (Q must not be the identity).
def add_aff(p: Pt, q: Aff) -> Pt:
  Pt{+x1, +y1, +z1} = p
  Aff{+x2, +y2} = q
  +t0a = B.mul(x1, x2)
  +t1a = B.mul(y1, y2)
  t3a = B.mul(B.add(x2, y2), B.add(x1, y1))
  +t3 = B.sub(t3a, B.add(t0a, t1a))
  +t4 = B.add(B.mul(y2, z1), y1)
  y3a = B.add(B.mul(x2, z1), x1)
  +x3a = B.add(t0a, t0a)
  +t0 = B.add(x3a, t0a)
  +t2 = mul15(z1)
  +z3a = B.add(t1a, t2)
  +t1 = B.sub(t1a, t2)
  +y3b = mul15(y3a)
  x3 = B.sub(B.mul(t3, t1), B.mul(t4, y3b))
  y3 = B.add(B.mul(t1, z3a), B.mul(y3b, t0))
  z3 = B.add(B.mul(z3a, t4), B.mul(t0, t3))
  Pt{x3, y3, z3}

# RCB Algorithm 9: complete projective doubling, a = 0.
def double(p: Pt) -> Pt:
  Pt{+x, +y, +z} = p
  +t0 = B.sqr(y)
  +z3a = B.add(t0, t0)
  +z3b = B.add(z3a, z3a)
  +z3c = B.add(z3b, z3b)
  t1 = B.mul(y, z)
  +t2 = mul15(B.sqr(z))
  x3a = B.mul(t2, z3c)
  y3a = B.add(t0, t2)
  z3 = B.mul(t1, z3c)
  +t1b = B.add(t2, t2)
  t2b = B.add(t1b, t2)
  +t0b = B.sub(t0, t2b)
  +x3b = B.mul(t0b, B.mul(x, y))
  Pt{B.add(x3b, x3b), B.add(x3a, B.mul(t0b, y3a)), z3}

def neg(p: Pt) -> Pt:
  Pt{x, y, z} = p
  Pt{x, B.neg(y), z}

def sub(p: Pt, q: Pt) -> Pt:
  add(p, neg(q))

def from_aff(a: Aff) -> Pt:
  Aff{x, y} = a
  Pt{x, y, B.one()}

# Affine coordinates; the identity maps to (0, 0).
def to_aff(p: Pt) -> Aff:
  Pt{x, y, z} = p
  +zi = B.inv(z)
  Aff{B.mul(x, zi), B.mul(y, zi)}

# Projective equality: X1 Z2 == X2 Z1 and Y1 Z2 == Y2 Z1 (handles the identity).
def is_eq(p: Pt, q: Pt) -> Bool:
  Pt{+x1, +y1, +z1} = p
  Pt{+x2, +y2, +z2} = q
  Bool.and(B.is_eq(B.mul(x1, z2), B.mul(x2, z1)), B.is_eq(B.mul(y1, z2), B.mul(y2, z1)))

def add_if(b: Bool, p: Pt, +q: Pt) -> Pt:
  match b:
    case True{}:
      add(p, q)
    case False{}:
      p

# acc * 2^32 + w * q, scanning w from its top bit (left-to-right double-and-add).
def mul_w(n: Nat, w: U32, acc: Pt, +q: Pt) -> Pt:
  match n:
    case 0n:
      acc
    case 1n+k:
      +w2 = w
      mul_w(k, (w2 << 1n : U32), add_if(U32.is_eq((w2 >> 31n : U32), 1), double(acc), q), q)

# [s] p for a 256-bit little-endian scalar (canonical words of an fp element).
def scalar_mul(+p: Pt, s: Wd.W) -> Pt:
  Wd.W{w0, w1, w2, w3, w4, w5, w6, w7} = s
  a7 = mul_w(32n, w7, identity(), p)
  a6 = mul_w(32n, w6, a7, p)
  a5 = mul_w(32n, w5, a6, p)
  a4 = mul_w(32n, w4, a5, p)
  a3 = mul_w(32n, w3, a4, p)
  a2 = mul_w(32n, w2, a3, p)
  a1 = mul_w(32n, w1, a2, p)
  mul_w(32n, w0, a1, p)

def scalar_mul_s(+p: Pt, s: S.Fp) -> Pt:
  scalar_mul(p, S.to_words(s))

def enc_fin(a: Aff, +zero: Bool) -> Wd.W:
  Aff{x, +y} = a
  match zero:
    case True{}:
      Wd.zero()
    case False{}:
      Wd.set_top_bit(B.to_words(x), B.low_bit(y))

# 32-byte compressed encoding (pasta_curves to_bytes).
def encode(+p: Pt) -> Wd.W:
  enc_fin(to_aff(p), is_identity(p))

def dec_y(+x: B.Fq, +ysign: U32, my: Maybe<&2, B.Fq>) -> Maybe<&2, Pt>:
  match my:
    case None{}:
      None{}
    case Some{+y}:
      Some{Pt{x, B.sel((B.low_bit(y) .^. ysign : U32), B.neg(y), y), B.one()}}

# x = 0: the identity if the sign bit is clear; otherwise y^2 = 5 (no solution: 5 is a non-residue).
def dec_y0(b: Bool, +x: B.Fq, +ysign: U32) -> Maybe<&2, Pt>:
  match b:
    case True{}:
      Some{identity()}
    case False{}:
      dec_y(x, ysign, B.sqrt(B.add(B.mul(B.sqr(x), x), B.from_u32(5))))

def dec_xz(z: Bool, +x: B.Fq, +ysign: U32) -> Maybe<&2, Pt>:
  match z:
    case True{}:
      dec_y0(U32.is_eq(ysign, 0), x, ysign)
    case False{}:
      dec_y(x, ysign, B.sqrt(B.add(B.mul(B.sqr(x), x), B.from_u32(5))))

def dec_x(+x: B.Fq, +ysign: U32, +canon: Bool) -> Maybe<&2, Pt>:
  match canon:
    case False{}:
      None{}
    case True{}:
      dec_xz(B.is_zero(x), x, ysign)

# Inverse of encode (pasta_curves from_bytes): rejects non-canonical x and non-points.
def decompress(+w: Wd.W) -> Maybe<&2, Pt>:
  +xw = Wd.clear_top_bit(w)
  dec_x(B.from_words(xw), Wd.top_bit(w), Wd.is_lt(xw, B.modulus()))
