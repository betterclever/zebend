  +a11 = mul(sqr_n(8n, a10), inv_g13(t))
  +a12 = mul(sqr_n(7n, a11), inv_g21(t))
  a12

def inv_c3(+t: inv_T, acc: Fq) -> Fq:
  +a0 = acc
  +a1 = mul(sqr_n(9n, a0), inv_g15(t))
  +a2 = mul(sqr_n(5n, a1), inv_g13(t))
  +a3 = mul(sqr_n(3n, a2), inv_g3(t))
  +a4 = mul(sqr_n(8n, a3), inv_g15(t))
  +a5 = mul(sqr_n(3n, a4), inv_g3(t))
  +a6 = mul(sqr_n(7n, a5), inv_g9(t))
  +a7 = mul(sqr_n(9n, a6), inv_g15(t))
  +a8 = mul(sqr_n(6n, a7), inv_g21(t))
  +a9 = mul(sqr_n(6n, a8), inv_g31(t))
  +a10 = mul(sqr_n(5n, a9), inv_g31(t))
  +a11 = mul(sqr_n(5n, a10), inv_g31(t))
  +a12 = mul(sqr_n(4n, a11), inv_g13(t))
  a12

def inv_c4(+t: inv_T, acc: Fq) -> Fq:
  +a0 = acc
  +a1 = mul(sqr_n(3n, a0), inv_g3(t))
  +a2 = mul(sqr_n(8n, a1), inv_g21(t))
  +a3 = mul(sqr_n(7n, a2), inv_g31(t))
  +a4 = mul(sqr_n(5n, a3), inv_g31(t))
  +a5 = mul(sqr_n(5n, a4), inv_g31(t))
  +a6 = mul(sqr_n(4n, a5), inv_g15(t))
  +a7 = mul(sqr_n(4n, a6), inv_g7(t))
  +a8 = mul(sqr_n(7n, a7), inv_g31(t))
  +a9 = mul(sqr_n(5n, a8), inv_g29(t))
  +a10 = mul(sqr_n(5n, a9), inv_g31(t))
  +a11 = mul(sqr_n(5n, a10), inv_g31(t))
  +a12 = mul(sqr_n(5n, a11), inv_g31(t))
  a12

def inv_c5(+t: inv_T, acc: Fq) -> Fq:
  +a0 = acc
  +a1 = mul(sqr_n(5n, a0), inv_g31(t))
  +a2 = mul(sqr_n(5n, a1), inv_g31(t))
  +a3 = mul(sqr_n(5n, a2), inv_g31(t))
  +a4 = mul(sqr_n(4n, a3), inv_g13(t))
  +a5 = mul(sqr_n(6n, a4), inv_g21(t))
  +a6 = mul(sqr_n(4n, a5), inv_g5(t))
  +a7 = mul(sqr_n(3n, a6), inv_g1(t))
  a7

# x^(p-2) = x^-1 (0 -> 0)
def inv(x: Fq) -> Fq:
  +t = inv_pre(x)
  +r0 = inv_g13(t)
  +r1 = inv_c0(t, r0)
  +r2 = inv_c1(t, r1)
  +r3 = inv_c2(t, r2)
  +r4 = inv_c3(t, r3)
  +r5 = inv_c4(t, r4)
  +r6 = inv_c5(t, r5)
  r6

type pow_sqrt_T is Data:
  pow_sqrt_T{x1: Fq, x3: Fq, x5: Fq, x7: Fq, x9: Fq, x11: Fq, x13: Fq, x15: Fq, x17: Fq, x19: Fq, x21: Fq, x23: Fq, x25: Fq, x27: Fq, x29: Fq, x31: Fq}

def pow_sqrt_pre(+x: Fq) -> pow_sqrt_T:
  +x1 = x
  +xx = sqr(x1)
  +x3 = mul(x1, xx)
  +x5 = mul(x3, xx)
  +x7 = mul(x5, xx)
  +x9 = mul(x7, xx)
  +x11 = mul(x9, xx)
  +x13 = mul(x11, xx)
  +x15 = mul(x13, xx)
  +x17 = mul(x15, xx)
  +x19 = mul(x17, xx)
  +x21 = mul(x19, xx)
  +x23 = mul(x21, xx)
  +x25 = mul(x23, xx)
  +x27 = mul(x25, xx)
  +x29 = mul(x27, xx)
  +x31 = mul(x29, xx)
  pow_sqrt_T{x1, x3, x5, x7, x9, x11, x13, x15, x17, x19, x21, x23, x25, x27, x29, x31}

def pow_sqrt_g1(t: pow_sqrt_T) -> Fq:
  pow_sqrt_T{+x1, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _} = t
  x1

