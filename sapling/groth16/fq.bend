  +a0 = acc
  +a1 = mul(sqr_n(3n, a0), inv_g5(t))
  +a2 = mul(sqr_n(6n, a1), inv_g15(t))
  +a3 = mul(sqr_n(6n, a2), inv_g27(t))
  +a4 = mul(sqr_n(3n, a3), inv_g1(t))
  +a5 = mul(sqr_n(8n, a4), inv_g13(t))
  +a6 = mul(sqr_n(7n, a5), inv_g23(t))
