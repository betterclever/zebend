  +a11 = mul(sqr_n(8n, a10), inv_g29(t))
  +a12 = mul(sqr_n(4n, a11), inv_g13(t))
  a12

def inv_c2(+t: inv_T, acc: Fq) -> Fq:
  +a0 = acc
  +a1 = mul(sqr_n(7n, a0), inv_g23(t))
  +a2 = mul(sqr_n(9n, a1), inv_g19(t))
  +a3 = mul(sqr_n(5n, a2), inv_g25(t))
