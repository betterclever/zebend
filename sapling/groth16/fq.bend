def inv_c0(+t: inv_T, acc: Fq) -> Fq:
  +a0 = acc
  +a1 = mul(sqr_n(13n, a0), inv_g17(t))
  +a2 = mul(sqr_n(7n, a1), inv_g15(t))
  +a3 = mul(sqr_n(4n, a2), inv_g5(t))
  +a4 = mul(sqr_n(6n, a3), inv_g7(t))
  +a5 = mul(sqr_n(7n, a4), inv_g23(t))
  +a6 = mul(sqr_n(5n, a5), inv_g31(t))
  +a7 = mul(sqr_n(5n, a6), inv_g25(t))
  +a8 = mul(sqr_n(3n, a7), inv_g5(t))
  +a9 = mul(sqr_n(6n, a8), inv_g13(t))
  +a10 = mul(sqr_n(6n, a9), inv_g9(t))
  +a11 = mul(sqr_n(3n, a10), inv_g3(t))
  +a12 = mul(sqr_n(8n, a11), inv_g27(t))
  a12

