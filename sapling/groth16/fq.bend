# 1 if a == b else 0 (branch-free).
def eq(a: Fq, b: Fq) -> U32:
  Fq{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7, +a8, +a9, +a10, +a11} = a
  Fq{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7, +b8, +b9, +b10, +b11} = b
  +v1 = ((a0 .^. b0) .|. (a1 .^. b1) .|. (a2 .^. b2) .|. (a3 .^. b3) .|. (a4 .^. b4) .|. (a5 .^. b5) .|. (a6 .^. b6) .|. (a7 .^. b7) .|. (a8 .^. b8) .|. (a9 .^. b9) .|. (a10 .^. b10) .|. (a11 .^. b11) : U32)
  +v2 = ((v1 .|. (0 - v1)) >> 31n : U32)
  (1 - v2 : U32)

# c == 1 selects a, c == 0 selects b (branch-free).
def sel(+c: U32, a: Fq, b: Fq) -> Fq:
  Fq{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7, +a8, +a9, +a10, +a11} = a
  Fq{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7, +b8, +b9, +b10, +b11} = b
  +mk = (0 - c : U32)
  +nm = (mk .^. 4294967295 : U32)
  +v1 = ((a0 .&. mk) .|. (b0 .&. nm) : U32)
  +v2 = ((a1 .&. mk) .|. (b1 .&. nm) : U32)
  +v3 = ((a2 .&. mk) .|. (b2 .&. nm) : U32)
  +v4 = ((a3 .&. mk) .|. (b3 .&. nm) : U32)
  +v5 = ((a4 .&. mk) .|. (b4 .&. nm) : U32)
  +v6 = ((a5 .&. mk) .|. (b5 .&. nm) : U32)
  +v7 = ((a6 .&. mk) .|. (b6 .&. nm) : U32)
  +v8 = ((a7 .&. mk) .|. (b7 .&. nm) : U32)
  +v9 = ((a8 .&. mk) .|. (b8 .&. nm) : U32)
  +v10 = ((a9 .&. mk) .|. (b9 .&. nm) : U32)
  +v11 = ((a10 .&. mk) .|. (b10 .&. nm) : U32)
  +v12 = ((a11 .&. mk) .|. (b11 .&. nm) : U32)
  Fq{v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12}

# 1 if the raw 384-bit value a < p (canonical), else 0.
def lt_p(a: Fq) -> U32:
  Fq{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7, +a8, +a9, +a10, +a11} = a
  +v1 = U32.mac64(2, a0, a1, 1, 0, 21844, 1174470656, 1, 0)
