# x^((p+1)/4): a square root of x when x is a square (p = 3 mod 4)
def pow_sqrt(x: Fq) -> Fq:
  +t = pow_sqrt_pre(x)
  +r0 = pow_sqrt_g13(t)
  +r1 = pow_sqrt_c0(t, r0)
  +r2 = pow_sqrt_c1(t, r1)
  +r3 = pow_sqrt_c2(t, r2)
  +r4 = pow_sqrt_c3(t, r3)
  +r5 = pow_sqrt_c4(t, r4)
  +r6 = pow_sqrt_c5(t, r5)
  r6

# Square root for public inputs; None if x is not a square.
def maybe_if(b: Bool, r: Fq) -> Maybe<&2, Fq>:
  match b:
    case True{}:
      Some{r}
    case False{}:
      None{}

def sqrt(+x: Fq) -> Maybe<&2, Fq>:
  +r = pow_sqrt(x)
  maybe_if(is_eq(sqr(r), x), r)
