# Adaptation of Algorithm 26, eprint 2010/354 (the crate's doubling_step).
def dbl_step(r: R2) -> St:
  R2{+rx, +ry, +rz} = r
  +tmp0 = E.sqr(rx)
  +tmp1 = E.sqr(ry)
  +tmp2 = E.sqr(tmp1)
  +tmp3a = E.sub(E.sub(E.sqr(E.add(tmp1, rx)), tmp0), tmp2)
  +tmp3 = E.add(tmp3a, tmp3a)
  +tmp4 = E.add(E.add(tmp0, tmp0), tmp0)
  +tmp6 = E.add(rx, tmp4)
  +tmp5 = E.sqr(tmp4)
  +zsq = E.sqr(rz)
  +nx = E.sub(E.sub(tmp5, tmp3), tmp3)
  +nz = E.sub(E.sub(E.sqr(E.add(rz, ry)), tmp1), zsq)
  +t2b = E.dbl(E.dbl(E.dbl(tmp2)))
  +ny = E.sub(E.mul(E.sub(tmp3, nx), tmp4), t2b)
  +t3b = E.mul(tmp4, zsq)
  +t3c = E.neg(E.add(t3b, t3b))
  +t1b = E.dbl(E.dbl(tmp1))
  +t6b = E.sub(E.sub(E.sub(E.sqr(tmp6), tmp0), tmp5), t1b)
  +t0b = E.mul(nz, zsq)
  St{R2{nx, ny, nz}, Co{E.add(t0b, t0b), t3c, t6b}}

# Adaptation of Algorithm 27, eprint 2010/354 (the crate's addition_step).
def add_step(r: R2, +q: G2.Aff) -> St:
  R2{+rx, +ry, +rz} = r
  G2.Aff{+qx, +qy} = q
  +zsq = E.sqr(rz)
  +ysq = E.sqr(qy)
  +t0 = E.mul(zsq, qx)
  +t1 = E.mul(E.sub(E.sub(E.sqr(E.add(qy, rz)), ysq), zsq), zsq)
  +t2 = E.sub(t0, rx)
  +t3 = E.sqr(t2)
  +t4 = E.dbl(E.dbl(t3))
  +t5 = E.mul(t4, t2)
  +t6 = E.sub(E.sub(t1, ry), ry)
  +t9 = E.mul(t6, qx)
  +t7 = E.mul(t4, rx)
  +nx = E.sub(E.sub(E.sub(E.sqr(t6), t5), t7), t7)
  +nz = E.sub(E.sub(E.sqr(E.add(rz, t2)), zsq), t3)
  +t8 = E.mul(E.sub(t7, nx), t6)
  +t0b = E.mul(ry, t5)
  +ny = E.sub(t8, E.add(t0b, t0b))
  +t10 = E.sub(E.sub(E.sqr(E.add(qy, nz)), ysq), E.sqr(nz))
  +t9b = E.sub(E.add(t9, t9), t10)
  +t6n = E.neg(t6)
  St{R2{nx, ny, nz}, Co{E.add(nz, nz), E.add(t6n, t6n), t9b}}

def r_of(+q: G2.Aff) -> R2:
  G2.Aff{x, y} = q
  R2{x, y, E.one()}

# The crate's ell(): f * line(c) evaluated at p.
def ell(f: T.Fq12, c: Co, +p: G1.Aff) -> T.Fq12:
  Co{c0, c1, c2} = c
  G1.Aff{+px, +py} = p
  T.mul_by_014(f, c2, E.mul_fq(c1, px), E.mul_fq(c0, py))

def ell_if(b: U32, f: T.Fq12, c: Co, +p: G1.Aff) -> T.Fq12:
  match b:
    case 0:
      f
    case _:
      ell(f, c, p)

# Coefficients of a fixed G2 point (the crate's G2Prepared), with one leading dummy.
# st carries the line of the previous step, emitted when the next step runs.
def prep_go(s: Sc, st: St, +q: G2.Aff) -> +List<Co>:
  match s st:
    case SD{t} St{r, co}:
      co <> prep_go(t, dbl_step(r), q)
    case SA{t} St{r, co}:
      co <> prep_go(t, add_step(r, q), q)
    case SS{t} St{r, co}:
      prep_go(t, St{r, co}, q)
    case SEnd{} St{_, co}:
      co <> Nil{}

def tail(xs: +List<Co>) -> +List<Co>:
  match xs:
    case Con{_, t}:
      t
    case Nil{}:
      Nil{}

def prepare(+q: G2.Aff) -> +List<Co>:
  tail(prep_go(sched(), St{r_of(q), co_zero()}, q))

# The three-term line update at one Miller loop step: B's line (computed now) at A, the
# prepared -gamma line at acc, the prepared -delta line at C. ea/eg/ed: 1 = use the term
# (0 skips it, as the crate does for identity points).
# PsB is never built: the self-reference makes Ps boxed (one word), keeping ml_go's
# parameters under Bend's 247-word limit.
type Ps is Data:
  Ps{q: G2.Aff, pa: G1.Aff, pg: G1.Aff, pd: G1.Aff, ea: U32, eg: U32, ed: U32}
  PsB{b: Ps}

def mk_ps(q: G2.Aff, pa: G1.Aff, pg: G1.Aff, pd: G1.Aff, ea: U32, eg: U32, ed: U32) -> Ps:
  Ps{q, pa, pg, pd, ea, eg, ed}

def ps_q(ps: Ps) -> G2.Aff:
  match ps:
    case Ps{+q, _, _, _, _, _, _}:
      q
    case _:
      G2.Aff{E.zero(), E.zero()}

def lines(f: T.Fq12, co: Co, g: Co, d: Co, ps: Ps) -> T.Fq12:
  match ps:
    case Ps{_, +pa, +pg, +pd, +ea, +eg, +ed}:
      ell_if(ed, ell_if(eg, ell_if(ea, f, co, pa), g, pg), d, pd)
    case _:
      f

# Multi Miller loop: [(A, B on the fly), (acc, gs), (C, ds)].
def ml_go(s: Sc, st: St, f: T.Fq12, gs: +List<Co>, ds: +List<Co>, +ps: Ps) -> T.Fq12:
  match s st gs ds:
    case SD{t} St{r, _} _ _:
      ml_go(t, dbl_step(r), f, gs, ds, ps)
    case SA{t} St{r, co} Con{g, gt} Con{d, dt}:
      ml_go(t, add_step(r, ps_q(ps)), lines(f, co, g, d, ps), gt, dt, ps)
    case SS{t} St{r, co} Con{g, gt} Con{d, dt}:
      ml_go(t, St{r, co_zero()}, T.sqr(lines(f, co, g, d, ps)), gt, dt, ps)
    case SEnd{} St{_, co} Con{g, _} Con{d, _}:
      T.conj(lines(f, co, g, d, ps))
    case _ _ _ _:
      f

def miller(gs: +List<Co>, ds: +List<Co>, +ps: Ps) -> T.Fq12:
  ml_go(sched(), St{r_of(ps_q(ps)), co_zero()}, T.one(), gs, ds, ps)

def dummies(n: Nat) -> +List<Co>:
  match n:
    case 0n:
      Nil{}
    case 1n+k:
      co_zero() <> dummies(k)

# The single Miller loop of (p, q) (the other two terms skipped).
def miller1(+p: G1.Aff, +q: G2.Aff) -> T.Fq12:
  miller(dummies(68n), dummies(68n), mk_ps(q, p, p, p, 1, 0, 0))

# ---- final exponentiation

type P2 is Data:
  P2{x: E.Fq2, y: E.Fq2}

def fp4_square(+a: E.Fq2, +b: E.Fq2) -> P2:
  +t0 = E.sqr(a)
  +t1 = E.sqr(b)
  +c0 = E.add(E.mul_nr(t1), t0)
  P2{c0, E.sub(E.sub(E.sqr(E.add(a, b)), t0), t1)}

# (3 t.x - 2 za, 3 t.y + 2 zb)
def grp_a(t: P2, +za: E.Fq2, +zb: E.Fq2) -> P2:
  P2{+t0, +t1} = t
  +u = E.sub(t0, za)
  +v = E.add(t1, zb)
  P2{E.add(E.add(u, u), t0), E.add(E.add(v, v), t1)}

# (3 nr(t.y) + 2 za, 3 t.x - 2 zb)
def grp_b(t: P2, +za: E.Fq2, +zb: E.Fq2) -> P2:
  P2{+t2, t3} = t
  +n = E.mul_nr(t3)
  +u = E.add(n, za)
  +v = E.sub(t2, zb)
  P2{E.add(E.add(u, u), n), E.add(E.add(v, v), t2)}

def cs_build(a: P2, b: P2, c: P2) -> T.Fq12:
  P2{a0, a1} = a
  P2{b0, b1} = b
  P2{c0, c1} = c
  T.Fq12{S.Fq6{a0, c0, b1}, S.Fq6{b0, a1, c1}}

# Granger-Scott squaring in the cyclotomic subgroup (the crate's cyclotomic_square).
def cyc_sqr(f: T.Fq12) -> T.Fq12:
  match f:
    case T.Fq12{S.Fq6{+z0, +z4, +z3}, S.Fq6{+z2, +z1, +z5}}:
      cs_build(grp_a(fp4_square(z0, z1), z0, z1), grp_b(fp4_square(z4, z5), z2, z3), grp_a(fp4_square(z2, z3), z4, z5))
    case _:
      f

def cyc_sqr_n(n: Nat, f: T.Fq12) -> T.Fq12:
  match n:
    case 0n:
      f
    case 1n+k:
      cyc_sqr_n(k, cyc_sqr(f))

# f^|x| in the cyclotomic subgroup, conjugated (= f^x, x < 0): the crate's cycolotomic_exp.
def cyc_exp(+f: T.Fq12) -> T.Fq12:
  +t0 = f
  +t1 = T.mul(cyc_sqr_n(1n, t0), f)
  +t2 = T.mul(cyc_sqr_n(2n, t1), f)
  +t3 = T.mul(cyc_sqr_n(3n, t2), f)
  +t4 = T.mul(cyc_sqr_n(9n, t3), f)
  +t5 = T.mul(cyc_sqr_n(32n, t4), f)
  T.conj(cyc_sqr_n(16n, t5))


def frob2(f: T.Fq12) -> T.Fq12:
  T.frob(T.frob(f))

# The crate's final_exponentiation (its frobenius^6 is the conjugate).
def final_exp(+f: T.Fq12) -> T.Fq12:
  +t0a = T.conj(f)
  +t1a = T.inv(f)
  +t2a = T.mul(t0a, t1a)
  +t1b = t2a
  +t2b = T.mul(frob2(t2a), t1b)
  +fa = t2b
  +t1c = T.conj(cyc_sqr(t2b))
  +t3a = cyc_exp(t2b)
  +t4a = T.mul(t1c, t3a)
  +t1d = cyc_exp(t4a)
  +t4b = T.conj(t4a)
  +fb = T.mul(fa, t4b)
  +t4c = cyc_sqr(t3a)
  +t0b = cyc_exp(t1d)
  +t3b = frob2(T.mul(t3a, t0b))
  +fc = T.mul(fb, t3b)
  +t4d = T.mul(t4c, cyc_exp(t0b))
  +fd = T.mul(fc, cyc_exp(t4d))
  +t4e = T.mul(t4d, T.conj(t2b))
  +t2c = T.frob(frob2(T.mul(t2b, t1d)))
  +fe = T.mul(fd, t2c)
  T.mul(fe, T.frob(t4e))
