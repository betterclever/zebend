  +a2 = mul(sqr_n(9n, a1), pow_pm1d2_g19(t))
  +a3 = mul(sqr_n(5n, a2), pow_pm1d2_g25(t))
  +a4 = mul(sqr_n(2n, a3), pow_pm1d2_g3(t))
  +a5 = mul(sqr_n(7n, a4), pow_pm1d2_g5(t))
  +a6 = mul(sqr_n(7n, a5), pow_pm1d2_g9(t))
  +a7 = mul(sqr_n(6n, a6), pow_pm1d2_g23(t))
  +a8 = mul(sqr_n(5n, a7), pow_pm1d2_g29(t))
  +a9 = mul(sqr_n(5n, a8), pow_pm1d2_g19(t))
  +a10 = mul(sqr_n(5n, a9), pow_pm1d2_g19(t))
  +a11 = mul(sqr_n(8n, a10), pow_pm1d2_g13(t))
  +a12 = mul(sqr_n(7n, a11), pow_pm1d2_g21(t))
  a12

