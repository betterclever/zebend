# a^((p-1)/2)
def pow_pm1d2(x: Fq2) -> Fq2:
  +t = pow_pm1d2_pre(x)
  +r0 = pow_pm1d2_g13(t)
  +r1 = pow_pm1d2_c0(t, r0)
  +r2 = pow_pm1d2_c1(t, r1)
  +r3 = pow_pm1d2_c2(t, r2)
  +r4 = pow_pm1d2_c3(t, r3)
  +r5 = pow_pm1d2_c4(t, r4)
  +r6 = pow_pm1d2_c5(t, r5)
  r6

def maybe_if(b: Bool, r: Fq2) -> Maybe<&2, Fq2>:
  match b:
    case True{}:
      Some{r}
    case False{}:
      None{}

def sqrt_pick(b: Bool, +x0: Fq2, alpha: Fq2) -> Fq2:
  match b:
    case True{}:
      Fq2{x00, x01} = x0
      Fq2{F.neg(x01), x00}
    case False{}:
      mul(pow_pm1d2(add(alpha, one())), x0)

# Square root (Algorithm 9 of eprint 2012/685, as the crate); None if a is not a square.
def sqrt(+a: Fq2) -> Maybe<&2, Fq2>:
  +a1 = pow_pm3d4(a)
  +alpha = mul(sqr(a1), a)
  +x0 = mul(a1, a)
  +s = sqrt_pick(is_eq(alpha, neg(one())), x0, alpha)
  maybe_if(is_eq(sqr(s), a), s)
