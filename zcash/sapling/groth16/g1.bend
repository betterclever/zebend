def identity() -> Pt:
  Pt{F.zero(), F.one(), F.zero()}

def is_identity(p: Pt) -> Bool:
  Pt{_, _, z} = p
  F.is_zero(z)

# 3b * a
def mul_b3(+a: F.Fq) -> F.Fq:
  +a2 = F.add(a, a)
  +a4 = F.add(a2, a2)
  +a8 = F.add(a4, a4)
  F.add(a8, a4)

# RCB Algorithm 7: complete projective addition, a = 0.
def add(p: Pt, q: Pt) -> Pt:
  Pt{+x1, +y1, +z1} = p
  Pt{+x2, +y2, +z2} = q
  +t0 = F.mul(x1, x2)
  +t1 = F.mul(y1, y2)
  +t2 = F.mul(z1, z2)
  t3a = F.mul(F.add(x1, y1), F.add(x2, y2))
  +t3 = F.sub(t3a, F.add(t0, t1))
  t4a = F.mul(F.add(y1, z1), F.add(y2, z2))
  +t4 = F.sub(t4a, F.add(t1, t2))
  x3a = F.mul(F.add(x1, z1), F.add(x2, z2))
  y3a = F.sub(x3a, F.add(t0, t2))
  +t0b = F.add(F.add(t0, t0), t0)
  +t2b = mul_b3(t2)
  +z3a = F.add(t1, t2b)
  +t1b = F.sub(t1, t2b)
  +y3b = mul_b3(y3a)
  x3 = F.sub(F.mul(t3, t1b), F.mul(t4, y3b))
  y3 = F.add(F.mul(t1b, z3a), F.mul(y3b, t0b))
  z3 = F.add(F.mul(z3a, t4), F.mul(t0b, t3))
  Pt{x3, y3, z3}

# RCB Algorithm 8: mixed addition P + Q, Q affine and not the identity (P may be).
def add_aff(p: Pt, q: Aff) -> Pt:
  Pt{+x1, +y1, +z1} = p
  Aff{+x2, +y2} = q
  +t0a = F.mul(x1, x2)
  +t1a = F.mul(y1, y2)
  t3a = F.mul(F.add(x2, y2), F.add(x1, y1))
  +t3 = F.sub(t3a, F.add(t0a, t1a))
  +t4 = F.add(F.mul(y2, z1), y1)
  y3a = F.add(F.mul(x2, z1), x1)
  +x3a = F.add(t0a, t0a)
  +t0 = F.add(x3a, t0a)
  +t2 = mul_b3(z1)
  +z3a = F.add(t1a, t2)
  +t1 = F.sub(t1a, t2)
  +y3b = mul_b3(y3a)
  x3 = F.sub(F.mul(t3, t1), F.mul(t4, y3b))
  y3 = F.add(F.mul(t1, z3a), F.mul(y3b, t0))
  z3 = F.add(F.mul(z3a, t4), F.mul(t0, t3))
  Pt{x3, y3, z3}

# RCB Algorithm 9: complete projective doubling, a = 0.
def double(p: Pt) -> Pt:
  Pt{+x, +y, +z} = p
  +t0 = F.sqr(y)
  +z3a = F.add(t0, t0)
  +z3b = F.add(z3a, z3a)
  +z3c = F.add(z3b, z3b)
  t1 = F.mul(y, z)
  +t2 = mul_b3(F.sqr(z))
  x3a = F.mul(t2, z3c)
  y3a = F.add(t0, t2)
  z3 = F.mul(t1, z3c)
  +t1b = F.add(t2, t2)
  t2b = F.add(t1b, t2)
  +t0b = F.sub(t0, t2b)
  +x3b = F.mul(t0b, F.mul(x, y))
  Pt{F.add(x3b, x3b), F.add(x3a, F.mul(t0b, y3a)), z3}

def dbl_n(n: Nat, p: Pt) -> Pt:
  match n:
    case 0n:
      p
    case 1n+k:
      dbl_n(k, double(p))

def neg(p: Pt) -> Pt:
  Pt{x, y, z} = p
  Pt{x, F.neg(y), z}

def from_aff(a: Aff) -> Pt:
  Aff{x, y} = a
  Pt{x, y, F.one()}

# Affine coordinates; the identity maps to (0, 0).
def to_aff(p: Pt) -> Aff:
  Pt{x, y, z} = p
  +zi = F.inv(z)
  Aff{F.mul(x, zi), F.mul(y, zi)}

# Projective equality (handles the identity).
def is_eq(p: Pt, q: Pt) -> Bool:
  Pt{+x1, +y1, +z1} = p
  Pt{+x2, +y2, +z2} = q
  Bool.and(F.is_eq(F.mul(x1, z2), F.mul(x2, z1)), F.is_eq(F.mul(y1, z2), F.mul(y2, z1)))

def add_if(b: Bool, p: Pt, +q: Pt) -> Pt:
  match b:
    case True{}:
      add(p, q)
    case False{}:
      p

# acc * 2^n + (top n bits of w) * q, left-to-right double-and-add.
def mul_w(n: Nat, w: U32, acc: Pt, +q: Pt) -> Pt:
  match n:
    case 0n:
      acc
    case 1n+k:
      +w2 = w
      mul_w(k, (w2 << 1n : U32), add_if(U32.is_eq((w2 >> 31n : U32), 1), double(acc), q), q)

# [|x|] p, |x| = 0xd201000000010000 (the BLS parameter, x < 0).
def mul_abs_x(+p: Pt) -> Pt:
  mul_w(32n, 65536, mul_w(32n, 3523280896, identity(), p), p)

# On the curve (affine): y^2 == x^3 + b.
def on_curve(a: Aff) -> Bool:
  Aff{+x, +y} = a
  F.is_eq(F.sqr(y), F.add(F.mul(F.sqr(x), x), curve_b()))

# beta: a non-trivial cube root of unity; phi(x, y) = (beta x, y).
def beta() -> F.Fq:
  F.Fq{2039112936, 821114395, 2127452714, 4088978859, 3323295735, 380160570, 1962738331, 3261739000, 1617960046, 909555558, 605774176, 85697707}

# [s] p for a 256-bit scalar given as 8 little-endian U32 words.
def mul_scalar(+p: Pt, w0: U32, w1: U32, w2: U32, w3: U32, w4: U32, w5: U32, w6: U32, w7: U32) -> Pt:
  a7 = mul_w(32n, w7, identity(), p)
  a6 = mul_w(32n, w6, a7, p)
  a5 = mul_w(32n, w5, a6, p)
  a4 = mul_w(32n, w4, a5, p)
  a3 = mul_w(32n, w3, a4, p)
  a2 = mul_w(32n, w2, a3, p)
  a1 = mul_w(32n, w1, a2, p)
  mul_w(32n, w0, a1, p)

# The crate's G1 subgroup test: phi(P) == -[x^2] P.
def in_subgroup(+a: Aff) -> Bool:
  Aff{+x, +y} = a
  +p = from_aff(mk_aff(x, y))
  is_eq(neg(mul_abs_x(mul_abs_x(p))), Pt{F.mul(x, beta()), y, F.one()})

def some_if(b: Bool, a: Aff) -> Maybe<&2, Aff>:
  match b:
    case True{}:
      Some{a}
    case False{}:
      None{}

def pick_y(+flip: U32, +y: F.Fq) -> F.Fq:
  F.sel(flip, F.neg(y), y)

def dec_root(r: Maybe<&2, F.Fq>, +x: F.Fq, +sort: U32) -> Maybe<&2, Aff>:
  match r:
    case Some{+y}:
      +a = mk_aff(x, pick_y((F.largest(y) .^. sort : U32), y))
      some_if(in_subgroup(a), a)
    case None{}:
      None{}

def dec_ok(b: Bool, +x: F.Fq, +sort: U32) -> Maybe<&2, Aff>:
  match b:
    case True{}:
      dec_root(F.sqrt(F.add(F.mul(F.sqr(x), x), curve_b())), x, sort)
    case False{}:
      None{}

# A compressed point as groth16's Proof::read accepts it: compression flag set,
# infinity flag clear (the identity is rejected), x canonical, x^3 + 4 a square,
# y chosen by the sort flag, P in the prime-order subgroup. xr: x's raw words with the
# three flag bits already masked; flags: byte 0 >> 5.
def decode(+flags: U32, +xr: F.Fq) -> Maybe<&2, Aff>:
  +x = F.from_raw(xr)
  +okf = ((flags >> 2n) .&. (1 - ((flags >> 1n) .&. 1)) .&. F.lt_p(xr) : U32)
  dec_ok(U32.is_eq(okf, 1), x, (flags .&. 1 : U32))
