# BLS12-381 G1: y^2 = x^3 + 4 over Fq. Complete projective formulas
# (Renes-Costello-Batina 2015, a = 0, b3 = 3b).
import Base
import ./fq.bend as F
import ./fq2.bend as E

type Pt is Data:
  Pt{x: F.Fq, y: F.Fq, z: F.Fq}

def curve_b() -> F.Fq:
  F.Fq{851955, 2854682624, 4231266314, 1405878322, 1795850367, 1200613754, 3870958807, 2983427774, 3212356399, 2395566907, 1032052350, 165037393}

type Aff is Data:
  Aff{x: F.Fq, y: F.Fq}

def mk_aff(x: F.Fq, y: F.Fq) -> Aff:
