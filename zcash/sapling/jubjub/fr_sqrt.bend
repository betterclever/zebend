def byte_of(b: U32, +w: U32) -> U32:
  match b:
    case 0:
      (w .&. 255 : U32)
    case 1:
      ((w >> 8n) .&. 255 : U32)
    case 2:
      ((w >> 16n) .&. 255 : U32)
    case _:
      (w >> 24n : U32)

# d in [0, 16) with x * w^(d * 2^28) = 1, for x a 2^4-th root of unity.
def dlog(a: B.Fr) -> U32:
  B.Fr{+l0, _, _, _, _, _, _, _} = a
  +h = ((l0 * 1680600655 : U32) >> 26n : U32)
  byte_of((h .&. 3 : U32), dl_t((h >> 2n : U32)))

# x^((t-1)/2): fr.bend's sliding-window chain.
def pow_t(+x: B.Fr) -> B.Fr:
  B.pow_c3(x)

# Window i of the discrete log of y = u^t: e_i = e_{i-1} + dlog(x_i * prod_j G[...]) << W*i.
def st1(+x: B.Fr, +e: U32) -> U32:
  (e + (dlog(B.mul(x, g6((e .&. 15 : U32)))) << 4n) : U32)

def st2(+x: B.Fr, +e: U32) -> U32:
  (e + (dlog(B.mul(B.mul(x, g5((e .&. 15 : U32))), g6(((e >> 4n) .&. 15 : U32)))) << 8n) : U32)

def st3(+x: B.Fr, +e: U32) -> U32:
  (e + (dlog(B.mul(B.mul(B.mul(x, g4((e .&. 15 : U32))), g5(((e >> 4n) .&. 15 : U32))), g6(((e >> 8n) .&. 15 : U32)))) << 12n) : U32)

def st4(+x: B.Fr, +e: U32) -> U32:
  (e + (dlog(B.mul(B.mul(B.mul(B.mul(x, g3((e .&. 15 : U32))), g4(((e >> 4n) .&. 15 : U32))), g5(((e >> 8n) .&. 15 : U32))), g6(((e >> 12n) .&. 15 : U32)))) << 16n) : U32)

def st5(+x: B.Fr, +e: U32) -> U32:
  (e + (dlog(B.mul(B.mul(B.mul(B.mul(B.mul(x, g2((e .&. 15 : U32))), g3(((e >> 4n) .&. 15 : U32))), g4(((e >> 8n) .&. 15 : U32))), g5(((e >> 12n) .&. 15 : U32))), g6(((e >> 16n) .&. 15 : U32)))) << 20n) : U32)

def st6(+x: B.Fr, +e: U32) -> U32:
  (e + (dlog(B.mul(B.mul(B.mul(B.mul(B.mul(B.mul(x, g1((e .&. 15 : U32))), g2(((e >> 4n) .&. 15 : U32))), g3(((e >> 8n) .&. 15 : U32))), g4(((e >> 12n) .&. 15 : U32))), g5(((e >> 16n) .&. 15 : U32))), g6(((e >> 20n) .&. 15 : U32)))) << 24n) : U32)

def st7(+x: B.Fr, +e: U32) -> U32:
  (e + (dlog(B.mul(B.mul(B.mul(B.mul(B.mul(B.mul(B.mul(x, g0((e .&. 15 : U32))), g1(((e >> 4n) .&. 15 : U32))), g2(((e >> 8n) .&. 15 : U32))), g3(((e >> 12n) .&. 15 : U32))), g4(((e >> 16n) .&. 15 : U32))), g5(((e >> 20n) .&. 15 : U32))), g6(((e >> 24n) .&. 15 : U32)))) << 28n) : U32)

# The root step, given uv = u^((t+1)/2) and v = u^((t-1)/2): uv * w^ceil(e/2) with
# u^t * w^e = 1. For a non-square u it is a square root of w * u.
def common(+uv: B.Fr, +v: B.Fr) -> B.Fr:
  +x7 = B.mul(uv, v)
  +x6 = B.sqr_n(4n, x7)
  +x5 = B.sqr_n(4n, x6)
  +x4 = B.sqr_n(4n, x5)
  +x3 = B.sqr_n(4n, x4)
  +x2 = B.sqr_n(4n, x3)
  +x1 = B.sqr_n(4n, x2)
  +x0 = B.sqr_n(4n, x1)
  +e0 = dlog(x0)
  +e1 = st1(x1, e0)
  +e2 = st2(x2, e1)
  +e3 = st3(x3, e2)
  +e4 = st4(x4, e3)
  +e5 = st5(x5, e4)
  +e6 = st6(x6, e5)
  +e7 = st7(x7, e6)
  +tt = ((e7 >> 1n) + (e7 .&. 1 : U32) : U32)
  B.mul(B.mul(B.mul(B.mul(B.mul(B.mul(B.mul(B.mul(uv, g0((tt .&. 15 : U32))), g1(((tt >> 4n) .&. 15 : U32))), g2(((tt >> 8n) .&. 15 : U32))), g3(((tt >> 12n) .&. 15 : U32))), g4(((tt >> 16n) .&. 15 : U32))), g5(((tt >> 20n) .&. 15 : U32))), g6(((tt >> 24n) .&. 15 : U32))), g7((tt >> 28n : U32)))

# A square root of x when x is a square (of w * x otherwise). Fixed work.
def root(+x: B.Fr) -> B.Fr:
  +v = pow_t(x)
  common(B.mul(x, v), v)

# 1 if r is a square root of x, else 0 (branch-free form for GPU callers).
def is_root(+r: B.Fr, +x: B.Fr) -> U32:
  B.eq(B.sqr(r), x)

# Drop-in for field3's sqrt: Some(r) with r^2 = x, None if x is not a square.
def sqrt(+x: B.Fr) -> Maybe<&2, B.Fr>:
  +r = root(x)
  B.maybe_if(B.is_eq(B.sqr(r), x), r)
