type QA is Data:
  QA{m0: L.MS, p0: L.BF, e0_0: L.BF, m1: L.MS, p1: L.BF, e1_0: L.BF, e1_1: L.BF, m2: L.MS, p2: L.BF, e2_0: L.BF, e2_1: L.BF, e2_2: L.BF, m3: L.MS, p3: L.BF, e3_0: L.BF, e3_1: L.BF, e3_2: L.BF, m4: L.MS, p4: L.BF, e4_0: L.BF, e4_1: L.BF}

def QA_m0(q: QA) -> L.MS:
  QA{+m0, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _} = q
  m0

def QA_p0(q: QA) -> L.BF:
  QA{_, +p0, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _} = q
  p0

def QA_e0_0(q: QA) -> L.BF:
