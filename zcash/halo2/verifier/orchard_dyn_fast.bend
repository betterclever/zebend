    case Con{+ae, ar} Con{+ie, ir} Con{+pe, pr} Con{+le, lr}:
      +r = pp_expr(theta, beta, gamma, x, y, l_0, l_last, active, fe, pcv, ae, ie, pe, le, h, st)
