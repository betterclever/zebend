def ex_loop(aes: +List<+List<Fp.Fp>>, ies: +List<+List<Fp.Fp>>, pes: +List<+List<Fp.Fp>>, les: +List<+List<Fp.Fp>>, +theta: L.BF, +beta: L.BF, +gamma: L.BF, +x: L.BF, +y: L.BF, +l_0: L.BF, +l_last: L.BF, +active: L.BF, +fe: +List<Fp.Fp>, +pcv: +List<Fp.Fp>, +h: L.BF, +st: L.St) -> L.HS:
