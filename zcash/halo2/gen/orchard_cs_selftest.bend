def count(+xs: +List<Z.F>, +ys: +List<Z.F>) -> U32:
  match xs ys:
    case Con{x, xt} Con{y, yt}:
      (Z.fis_eq(x, y) + count(xt, yt) : U32)
    case _ _:
      0

def main() -> IO(Unit):
  do IO<Unit>:
    +got : +List<Z.F> = C.gate_polys(A(), FX(), I())
    IO.print("gate polys matching halo2: " ++ U32.show(count(got, WANT())) ++ " / " ++ U32.show(U32.from_nat(List.length(&2, Z.F, WANT()))))
