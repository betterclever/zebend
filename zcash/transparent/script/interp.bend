# Zcash transparent script interpreter, part 2: the alt stack, CHECKSIG, CHECKMULTISIG,
# CHECKLOCKTIMEVERIFY, the evaluation loop, P2SH and the final verdict (script/iter.rs).
# GENERATED by gen_interp.py from interp_head.bend + interp_tail.bend; edit those.
import Base
import ../util.bend as U
import ./core.bend as C

def o_toalt(s: List<&2, +List<U32>>, +alt: List<&2, +List<U32>>, +ops: U32) -> C.R3:
  match s:
    case Con{a, t}:
      C.R3{True{}, t, a <> alt, ops}
    case _:
      C.fail3()

def o_fromalt(+s: List<&2, +List<U32>>, alt: List<&2, +List<U32>>, +ops: U32) -> C.R3:
  match alt:
    case Con{a, t}:
      C.R3{True{}, a <> s, t, ops}
    case _:
      C.fail3()

def cs_res(m: Maybe<&2, Bool>, +verify: Bool, +t: List<&2, +List<U32>>, +alt: List<&2, +List<U32>>, +ops: U32) -> C.R3:
  match m:
    case Some{+ok}:
      match verify:
        case True{}:
          C.R3{ok, t, alt, ops}
        case False{}:
          C.R3{True{}, C.vbool(ok) <> t, alt, ops}
    case None{}:
      C.fail3()

# (sig pubkey -- bool)
def o_checksig(+verify: Bool, s: List<&2, +List<U32>>, +alt: List<&2, +List<U32>>, +ops: U32, +env: C.Env) -> C.R3:
  match s:
    case Con{pk, Con{sig, t}}:
      cs_res(C.sig_valid(sig, pk, env), verify, t, alt, ops)
    case _:
      C.fail3()

# CHECKMULTISIG's loop state: signatures left (top first), counts, and status
# 0 running, 1 all signatures matched, 2 failed, 3 aborted (encoding error).
type MS is Data:
  MS{+sigs: List<&2, +List<U32>>, +ns: U32, +nk: U32, +st: U32}

def ml_apply(m: Maybe<&2, Bool>, +rest: List<&2, +List<U32>>, +sigs: List<&2, +List<U32>>, +ns: U32, +nk: U32) -> MS:
  match m:
    case Some{+ok}:
      +ns2 = Bool.pick(U32, ok, (ns - 1 : U32), ns)
      +nk2 = (nk - 1 : U32)
      MS{Bool.pick(List<&2, +List<U32>>, ok, rest, sigs), ns2, nk2,
         Bool.pick(U32, U32.is_gt(ns2, nk2), 2, Bool.pick(U32, U32.is_zero(ns2), 1, 0))}
    case None{}:
      MS{Nil{}, 0, 0, 3}

def ml_sig(sigs: List<&2, +List<U32>>, +k: +List<U32>, +ns: U32, +nk: U32, +env: C.Env) -> MS:
  match sigs:
    case Con{+s, +rest}:
      ml_apply(C.sig_valid(s, k, env), rest, s <> rest, ns, nk)
    case Nil{}:
      MS{Nil{}, ns, nk, 1}

def ml_go(done: Bool, +sigs: List<&2, +List<U32>>, +k: +List<U32>, +ns: U32, +nk: U32, +env: C.Env) -> MS:
  match done:
    case True{}:
      MS{sigs, ns, nk, 1}
    case False{}:
      ml_sig(sigs, k, ns, nk, env)

def ml_run(run: Bool, ms: MS, +k: +List<U32>, +env: C.Env) -> MS:
  match run:
    case True{}:
      MS{+sigs, +ns, +nk, _} = ms
      ml_go(U32.is_zero(ns), sigs, k, ns, nk, env)
    case False{}:
      ms

def ms_st(ms: MS) -> U32:
  MS{_, _, _, st} = ms
  st

# One signature per key, keys top first, until all signatures matched or too few keys remain.
def ml(keys: List<&2, +List<U32>>, +ms: MS, +env: C.Env) -> MS:
  match keys:
    case Nil{}:
      ms
    case Con{k, kt}:
      ml(kt, ml_run(U32.is_zero(ms_st(ms)), ms, k, env), env)

def msig_fin(ok: Bool, +good: Bool, +verify: Bool, +t: List<&2, +List<U32>>, +alt: List<&2, +List<U32>>, +ops: U32) -> C.R3:
  match ok:
    case True{}:
      Bool.pick(C.R3, verify, C.R3{good, t, alt, ops}, C.R3{True{}, C.vbool(good) <> t, alt, ops})
    case False{}:
      C.fail3()

def msig_end(+st: U32, +verify: Bool, +nulldummy: Bool, rest: List<&2, +List<U32>>, +alt: List<&2, +List<U32>>, +ops: U32) -> C.R3:
  match rest:
    case Con{dummy, t}:
      msig_fin(U32.is_ne(st, 3) && (Bool.not(nulldummy) || U.is_empty(dummy)), U32.is_le(st, 1), verify, t, alt, ops)
    case Nil{}:
      C.fail3()

def msig_go(ok: Bool, +nk: Nat, +m: Nat, +verify: Bool, +t: List<&2, +List<U32>>, +alt: List<&2, +List<U32>>, +ops: U32, +env: C.Env) -> C.R3:
  match ok:
    case True{}:
      +sigs = C.stake(C.sdrop(t, 1n+nk), m)
      +ms = ml(C.stake(t, nk), MS{sigs, U32.from_nat(m), U32.from_nat(nk), 0}, env)
      msig_end(ms_st(ms), verify, C.has(C.env_flags(env), C.f_nulldummy()), C.sdrop(t, (1n + nk + m : Nat)), alt, ops)
    case False{}:
      C.fail3()

def msig_m(mm: Maybe<&2, C.Num>, +nk: Nat, +verify: Bool, +t: List<&2, +List<U32>>, +alt: List<&2, +List<U32>>, +ops: U32, +env: C.Env) -> C.R3:
  match mm:
    case Some{n}:
      C.Num{+neg, +mag} = n
      +m = U32.to_nat(mag)
      msig_go(Bool.not(neg) && Nat.is_le(m, nk) && Nat.is_ge(C.slen(t), (nk + 1n + m + 1n : Nat)), nk, m, verify, t, alt, ops, env)
    case None{}:
      C.fail3()

def msig_k(ok: Bool, +nk: Nat, +verify: Bool, +t: List<&2, +List<U32>>, +alt: List<&2, +List<U32>>, +ops: U32, +env: C.Env) -> C.R3:
  match ok:
    case True{}:
      msig_m(C.parse_num(C.nth(t, nk), C.has(C.env_flags(env), C.f_minimaldata())), nk, verify, t, alt, ops, env)
    case False{}:
      C.fail3()

def msig_nk(mk: Maybe<&2, C.Num>, +verify: Bool, +t: List<&2, +List<U32>>, +alt: List<&2, +List<U32>>, +ops: U32, +env: C.Env) -> C.R3:
  match mk:
    case Some{n}:
      C.Num{+neg, +mag} = n
      +ops2 = (ops + mag : U32)
      +nk = U32.to_nat(mag)
      msig_k(Bool.not(neg) && U32.is_le(mag, 20) && U32.is_le(ops2, 201) && Nat.is_lt(nk, C.slen(t)), nk, verify, t, alt, ops2, env)
    case None{}:
      C.fail3()

# ([sig ...] num_of_signatures [pubkey ...] num_of_pubkeys -- bool), plus the extra dummy.
def o_msig(+verify: Bool, s: List<&2, +List<U32>>, +alt: List<&2, +List<U32>>, +ops: U32, +env: C.Env) -> C.R3:
  match s:
    case Con{a, t}:
      msig_nk(C.parse_num(a, C.has(C.env_flags(env), C.f_minimaldata())), verify, t, alt, ops, env)
    case _:
      C.fail3()

# CHECKLOCKTIMEVERIFY on a lock time of up to 5 bytes (top of stack, not popped).
def cltv_check(+v: +List<U32>, +env: C.Env) -> Bool:
  C.Env{+flags, _, +ctx} = env
  C.Ctx{_, _, _, _, +txlock, +final} = ctx
  +len = U.len(v)
  +b4 = U.byte_at(v, 4n)
  +five = U32.is_eq(len, 5)
  +neg = Bool.pick(Bool, five, U32.is_ne((b4 .&. 128 : U32), 0), U32.is_ne((U.last0(v, 0) .&. 128 : U32), 0))
  +big = five && U32.is_ne((b4 .&. 127 : U32), 0)
  +mag = Bool.pick(U32, five, U.le32(v), (U.le32(v) .&. U32.not((1 << U32.to_nat(((U32.max(len, 1) * 8) - 1 : U32)) : U32)) : U32))
  +zero = U32.is_zero(mag) && Bool.not(big)
  +minimal_ok = Bool.not(C.has(flags, C.f_minimaldata())) || U32.is_zero(len) || Bool.not(C.non_minimal(v, len))
  +lt_thr = U32.is_lt(txlock, 500000000)
  +v_thr = big || U32.is_ge(mag, 500000000)
  U32.is_le(len, 5) && minimal_ok && (Bool.not(neg) || zero) && Bool.not(big) && Bool.not(lt_thr && v_thr)
    && Bool.not(Bool.not(lt_thr) && Bool.not(v_thr)) && U32.is_le(mag, txlock) && Bool.not(final)

def cltv_on(on: Bool, +flags: U32, s: List<&2, +List<U32>>, +alt: List<&2, +List<U32>>, +ops: U32, +env: C.Env) -> C.R3:
  match on:
    case True{}:
      match s:
        case Con{+a, t}:
          C.R3{cltv_check(a, env), a <> t, alt, ops}
        case _:
          C.fail3()
    case False{}:
      C.R3{Bool.not(C.has(flags, C.f_discourage_nops())), s, alt, ops}

def o_cltv(+s: List<&2, +List<U32>>, +alt: List<&2, +List<U32>>, +ops: U32, +env: C.Env) -> C.R3:
  +flags = C.env_flags(env)
  cltv_on(C.has(flags, C.f_cltv()), flags, s, alt, ops, env)

# NOP1, NOP3..NOP10
def o_nop(+s: List<&2, +List<U32>>, +alt: List<&2, +List<U32>>, +ops: U32, +env: C.Env) -> C.R3:
  C.R3{Bool.not(C.has(C.env_flags(env), C.f_discourage_nops())), s, alt, ops}

