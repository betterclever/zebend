# n itself, as a plain value
def n_value() -> Sc:
  Sc{3493216577, 3218235020, 2940772411, 3132021990, 4294967294, 4294967295, 4294967295, 4294967295}

# R^2 mod n (to Montgomery form: mul(x, r2))
def r2() -> Sc:
  Sc{1742197056, 2305618452, 243071096, 1947506370, 1540163526, 3868718564, 2177276869, 2640780501}

# R mod n (1 in Montgomery form)
def mont_one() -> Sc:
  Sc{801750719, 1076732275, 1354194884, 1162945305, 1, 0, 0, 0}

# n - 2 (Fermat inversion exponent)
def n_minus_2() -> Sc:
  Sc{3493216575, 3218235020, 2940772411, 3132021990, 4294967294, 4294967295, 4294967295, 4294967295}


def eq(a: Sc, b: Sc) -> Bool:
  Sc{a0, a1, a2, a3, a4, a5, a6, a7} = a
  Sc{b0, b1, b2, b3, b4, b5, b6, b7} = b
  U32.is_eq(a0, b0) && U32.is_eq(a1, b1) && U32.is_eq(a2, b2) && U32.is_eq(a3, b3) && U32.is_eq(a4, b4) && U32.is_eq(a5, b5) && U32.is_eq(a6, b6) && U32.is_eq(a7, b7)

def is_zero(a: Sc) -> Bool:
  Sc{a0, a1, a2, a3, a4, a5, a6, a7} = a
  U32.is_zero((a0 .|. a1 .|. a2 .|. a3 .|. a4 .|. a5 .|. a6 .|. a7 : U32))

def zero() -> Sc:
  Sc{0, 0, 0, 0, 0, 0, 0, 0}

def be_word(+xs: +List<U32>, +i: Nat) -> U32:
  match xs:
    case Con{a, Con{b, Con{c, Con{d, _}}}}:
      ((a << 24n) .|. (b << 16n) .|. (c << 8n) .|. d : U32)
    case _:
      0

def drop(xs: +List<U32>, n: Nat) -> +List<U32>:
  match xs n:
    case Nil{} _:
      Nil{}
    case Con{h, t} 0n:
      h <> t
    case Con{_, t} 1n+p:
      drop(t, p)

# 4 big-endian bytes and the rest of the list; fewer than 4 bytes read as the word 0 and an
# empty rest (so every later word is 0 too, as when each word was read at its offset).
type R4 is Data:
  R4{w: U32, rest: +List<U32>}

def rd4(xs: +List<U32>) -> R4:
  match xs:
    case Con{a, Con{b, Con{c, Con{d, t}}}}:
      R4{((a << 24n) .|. (b << 16n) .|. (c << 8n) .|. d : U32), t}
    case _:
      R4{0, Nil{}}

def r4w(r: R4) -> U32:
  R4{w, _} = r
  w

def r4r(r: R4) -> +List<U32>:
  R4{_, t} = r
  t

# 32 big-endian bytes (missing bytes read as 0) as a value (no reduction), in one pass
# (speed round 2; round 1 read each word with its own drop from the head).
def from_be(+xs: +List<U32>) -> Sc:
  +r7 = rd4(xs)
  +r6 = rd4(r4r(r7))
  +r5 = rd4(r4r(r6))
  +r4 = rd4(r4r(r5))
  +r3 = rd4(r4r(r4))
  +r2 = rd4(r4r(r3))
  +r1 = rd4(r4r(r2))
  +r0 = rd4(r4r(r1))
  Sc{r4w(r0), r4w(r1), r4w(r2), r4w(r3), r4w(r4), r4w(r5), r4w(r6), r4w(r7)}

def be4(+w: U32, acc: +List<U32>) -> +List<U32>:
  (w >> 24n : U32) <> ((w >> 16n) .&. 255 : U32) <> ((w >> 8n) .&. 255 : U32) <> (w .&. 255 : U32) <> acc

def to_be(a: Sc) -> +List<U32>:
  Sc{a0, a1, a2, a3, a4, a5, a6, a7} = a
  be4(a7, be4(a6, be4(a5, be4(a4, be4(a3, be4(a2, be4(a1, be4(a0, Nil{}))))))))

def low_word(a: Sc) -> U32:
  Sc{a0, _, _, _, _, _, _, _} = a
  a0


# a + b mod n; a + b < 2n.
def add(a: Sc, b: Sc) -> Sc:
  Sc{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7} = a
  Sc{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7} = b
  +v1 = U32.mac64(0, a0, a1, 1, 0, b0, b1, 0, 0)
  +v2 = U32.mac64(1, a0, a1, 1, 0, b0, b1, 0, 0)
  +v3 = U32.mac64(2, a0, a1, 1, 0, b0, b1, 0, 0)
  +v4 = U32.mac64(3, a0, a1, 1, 0, b0, b1, 0, 0)
  +v5 = U32.mac64(0, a2, a3, 1, 0, b2, b3, v3, v4)
  +v6 = U32.mac64(1, a2, a3, 1, 0, b2, b3, v3, v4)
  +v7 = U32.mac64(2, a2, a3, 1, 0, b2, b3, v3, v4)
  +v8 = U32.mac64(3, a2, a3, 1, 0, b2, b3, v3, v4)
  +v9 = U32.mac64(0, a4, a5, 1, 0, b4, b5, v7, v8)
  +v10 = U32.mac64(1, a4, a5, 1, 0, b4, b5, v7, v8)
  +v11 = U32.mac64(2, a4, a5, 1, 0, b4, b5, v7, v8)
  +v12 = U32.mac64(3, a4, a5, 1, 0, b4, b5, v7, v8)
  +v13 = U32.mac64(0, a6, a7, 1, 0, b6, b7, v11, v12)
  +v14 = U32.mac64(1, a6, a7, 1, 0, b6, b7, v11, v12)
  +v15 = U32.mac64(2, a6, a7, 1, 0, b6, b7, v11, v12)
  +v16 = U32.mac64(3, a6, a7, 1, 0, b6, b7, v11, v12)
  +v17 = U32.mac64(0, v1, v2, 1, 0, 801750719, 1076732275, 0, 0)
  +v18 = U32.mac64(1, v1, v2, 1, 0, 801750719, 1076732275, 0, 0)
  +v19 = U32.mac64(2, v1, v2, 1, 0, 801750719, 1076732275, 0, 0)
  +v20 = U32.mac64(3, v1, v2, 1, 0, 801750719, 1076732275, 0, 0)
  +v21 = U32.mac64(0, v5, v6, 1, 0, 1354194884, 1162945305, v19, v20)
  +v22 = U32.mac64(1, v5, v6, 1, 0, 1354194884, 1162945305, v19, v20)
  +v23 = U32.mac64(2, v5, v6, 1, 0, 1354194884, 1162945305, v19, v20)
  +v24 = U32.mac64(3, v5, v6, 1, 0, 1354194884, 1162945305, v19, v20)
  +v25 = U32.mac64(0, v9, v10, 1, 0, 1, 0, v23, v24)
  +v26 = U32.mac64(1, v9, v10, 1, 0, 1, 0, v23, v24)
  +v27 = U32.mac64(2, v9, v10, 1, 0, 1, 0, v23, v24)
  +v28 = U32.mac64(3, v9, v10, 1, 0, 1, 0, v23, v24)
  +v29 = U32.mac64(0, v13, v14, 1, 0, 0, 0, v27, v28)
  +v30 = U32.mac64(1, v13, v14, 1, 0, 0, 0, v27, v28)
  +v31 = U32.mac64(2, v13, v14, 1, 0, 0, 0, v27, v28)
  +v32 = U32.mac64(3, v13, v14, 1, 0, 0, 0, v27, v28)
  +v33 = (v15 .|. v31 : U32)
  +v34 = (0 - v33 : U32)
  +v35 = ((v17 .&. v34) .|. (v1 .&. U32.not(v34)) : U32)
  +v36 = ((v18 .&. v34) .|. (v2 .&. U32.not(v34)) : U32)
  +v37 = ((v21 .&. v34) .|. (v5 .&. U32.not(v34)) : U32)
  +v38 = ((v22 .&. v34) .|. (v6 .&. U32.not(v34)) : U32)
  +v39 = ((v25 .&. v34) .|. (v9 .&. U32.not(v34)) : U32)
  +v40 = ((v26 .&. v34) .|. (v10 .&. U32.not(v34)) : U32)
  +v41 = ((v29 .&. v34) .|. (v13 .&. U32.not(v34)) : U32)
  +v42 = ((v30 .&. v34) .|. (v14 .&. U32.not(v34)) : U32)
  Sc{v35, v36, v37, v38, v39, v40, v41, v42}

# Montgomery square a * a / 2^256 mod n.
