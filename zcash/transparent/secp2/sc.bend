# GLV g1
def glv_g1() -> Sc:
  Sc{1172025393, 3901956250, 1911081599, 1034586644, 2458184469, 3899429092, 2815716301, 814141985}

# GLV g2
def glv_g2() -> Sc:
  Sc{2328133489, 359773358, 2650080966, 571607212, 180348100, 1867808681, 17729576, 3829628630}

# -b1 in Montgomery form
def glv_mb1_mont() -> Sc:
  Sc{182003260, 3305400528, 4205243714, 454853125, 2328133489, 359773358, 2650080966, 571607212}

# -b2 in Montgomery form
def glv_mb2_mont() -> Sc:
  Sc{1779713686, 212622928, 4089076025, 512396741, 3122941902, 393011045, 2383885696, 3260380651}

# lambda in Montgomery form
def lambda_mont() -> Sc:
  Sc{3381816478, 4034784061, 2210829388, 747890605, 1382645137, 1940481542, 2237191737, 1395146775}

# Number of 32-bit words up to the highest non-zero one (0 for 0).
def top_words(a: Sc) -> U32:
  Sc{a0, a1, a2, a3, a4, a5, a6, a7} = a
  Bool.pick(U32, U32.is_ne(a7, 0), 8, Bool.pick(U32, U32.is_ne(a6, 0), 7, Bool.pick(U32, U32.is_ne(a5, 0), 6,
    Bool.pick(U32, U32.is_ne(a4, 0), 5, Bool.pick(U32, U32.is_ne(a3, 0), 4, Bool.pick(U32, U32.is_ne(a2, 0), 3,
    Bool.pick(U32, U32.is_ne(a1, 0), 2, Bool.pick(U32, U32.is_ne(a0, 0), 1, 0))))))))

# Word j (0 for j >= 8).
def word(a: Sc, j: U32) -> U32:
  Sc{a0, a1, a2, a3, a4, a5, a6, a7} = a
  match j:
    case 0: a0
    case 1: a1
    case 2: a2
    case 3: a3
    case 4: a4
    case 5: a5
    case 6: a6
    case 7: a7
    case _: 0

# 2^(32 - s) as (lo, hi) words, s in 0..31: the multiplier that brings bit s to bit 32.
def pw_lo(s: U32) -> U32:
  match s:
    case 0: 0
    case 1: 2147483648
    case 2: 1073741824
    case 3: 536870912
    case 4: 268435456
    case 5: 134217728
    case 6: 67108864
    case 7: 33554432
    case 8: 16777216
    case 9: 8388608
    case 10: 4194304
    case 11: 2097152
    case 12: 1048576
    case 13: 524288
    case 14: 262144
    case 15: 131072
    case 16: 65536
    case 17: 32768
    case 18: 16384
    case 19: 8192
    case 20: 4096
    case 21: 2048
    case 22: 1024
    case 23: 512
    case 24: 256
    case 25: 128
    case 26: 64
    case 27: 32
    case 28: 16
    case 29: 8
    case 30: 4
    case 31: 2
    case _: 0

# 32 bits of a starting at bit i (bits past 255 read as 0): word 1 of (w_j + w_(j+1) 2^32) 2^(32-s).
def bits32(+a: Sc, +i: U32) -> U32:
  +j = (i >> 5n : U32)
  +s = (i .&. 31 : U32)
  U32.mac64(1, word(a, j), word(a, (j + 1 : U32)), pw_lo(s), Bool.pick(U32, U32.is_zero(s), 1, 0), 0, 0, 0, 0)
