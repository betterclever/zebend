# R^3 mod p: mul(R3(), x) = x * R^2 (for x * 2^256 in Montgomery form)
def R3() -> Fl:
  Fl{2072224475, 715016552, 2935485420, 662906086, 82598757, 2154159212, 899272391, 240323447}

def raw_one() -> Fl:
  Fl{1, 0, 0, 0, 0, 0, 0, 0}

def neg(a: Fl) -> Fl:
  sub(zero(), a)

def dbl(+a: Fl) -> Fl:
  add(a, a)

def is_eq(a: Fl, b: Fl) -> Bool:
  U32.is_eq(eq(a, b), 1)

def is_zero(a: Fl) -> Bool:
  U32.is_eq(eq(a, zero()), 1)

# raw words (ANY value < 2^256) -> Montgomery form, reduced mod p. R2 is the left operand
# (the one that must be < p; see gen_fields.py).
def from_raw(a: Fl) -> Fl:
  mul(R2(), a)

# Montgomery -> canonical raw words
def to_raw(a: Fl) -> Fl:
  mul(a, raw_one())

# low bit of the canonical value (Ed25519's 'is_negative')
def low_bit_raw(a: Fl) -> U32:
  Fl{+l0, _, _, _, _, _, _, _} = a
  (l0 .&. 1 : U32)

def low_bit(a: Fl) -> U32:
  low_bit_raw(to_raw(a))

def sqr_n(n: Nat, x: Fl) -> Fl:
  match n:
    case 0n:
      x
    case 1n+k:
      sqr_n(k, sqr(x))
