  match t:
    case Con{b, rest}:
      b2_w2(a, b, rest)
    case Nil{}:
      (a, Nil{})

def b2_word(xs: +List<U32>) -> U32 & +List<U32>:
  match xs:
    case Con{a, rest}:
      b2_w1(a, rest)
    case Nil{}:
      (0, Nil{})

