def b2_blk1(+w0: U32, p: U32 & +List<U32>) -> M16 & +List<U32>:
  (w1, r) = p
  b2_blk2(w0, w1, b2_word(r))

def b2_blk0(p: U32 & +List<U32>) -> M16 & +List<U32>:
  (w0, r) = p
  b2_blk1(w0, b2_word(r))

def b2_block(xs: +List<U32>) -> M16 & +List<U32>:
  b2_blk0(b2_word(xs))

def b2_last(+p: Nat) -> Bool:
  match p:
    case 0n:
      True{}
    case 1n+q:
      False{}

# mb is the next (block, rest) pair, read ahead so the recursion stays direct.
def b2_go(+fuel: Nat, h: H8, mb: M16 & +List<U32>, +t: U32, +len: U32) -> H8:
  match fuel:
    case 0n:
      h
    case 1n+p:
      (m, rest) = mb
      +t2 = U32.min((t + 128 : U32), len)
      b2_go(p, b2_compress(h, m, t2, b2_last(p)), b2_block(rest), t2, len)

def b2_w4(+w: U32, acc: +List<U32>) -> +List<U32>:
  (w .&. 255 : U32) <> ((w >> 8n) .&. 255 : U32) <> ((w >> 16n) .&. 255 : U32) <> (w >> 24n : U32) <> acc

def b2_out32(h: H8) -> +List<U32>:
  H8{h0l, h0h, h1l, h1h, h2l, h2h, h3l, h3h, _, _, _, _, _, _, _, _} = h
  b2_w4(h0l, b2_w4(h0h, b2_w4(h1l, b2_w4(h1h, b2_w4(h2l, b2_w4(h2h, b2_w4(h3l, b2_w4(h3h, Nil{}))))))))

def b2_out64(h: H8) -> +List<U32>:
  H8{h0l, h0h, h1l, h1h, h2l, h2h, h3l, h3h, h4l, h4h, h5l, h5h, h6l, h6h, h7l, h7h} = h
  b2_w4(h0l, b2_w4(h0h, b2_w4(h1l, b2_w4(h1h, b2_w4(h2l, b2_w4(h2h, b2_w4(h3l, b2_w4(h3h,
    b2_w4(h4l, b2_w4(h4h, b2_w4(h5l, b2_w4(h5h, b2_w4(h6l, b2_w4(h6h, b2_w4(h7l, b2_w4(h7h, Nil{}))))))))))))))))

def b2_nblocks(+len: U32) -> U32:
  U32.max(1, ((len + 127 : U32) >> 7n : U32))

def b2_state(+outlen: U32, pers: P4, +xs: +List<U32>) -> H8:
  +len = U32.from_nat(List.length(&2, U32, xs))
  b2_go(U32.to_nat(b2_nblocks(len)), b2_init(outlen, pers), b2_block(xs), 0, len)

# BLAKE2b-256 / BLAKE2b-512 of a byte list (bytes as U32 in 0..255) under a personalization.
def hash32(pers: P4, xs: +List<U32>) -> +List<U32>:
  b2_out32(b2_state(32, pers, xs))

def hash64(pers: P4, xs: +List<U32>) -> +List<U32>:
  b2_out64(b2_state(64, pers, xs))

