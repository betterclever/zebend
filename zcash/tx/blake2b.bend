def b2_w3(+a: U32, +b: U32, +c: U32, t: +List<U32>) -> U32 & +List<U32>:
  match t:
    case Con{d, rest}:
      ((a .|. (b << 8n) .|. (c << 16n) .|. (d << 24n) : U32), rest)
    case Nil{}:
      ((a .|. (b << 8n) .|. (c << 16n) : U32), Nil{})

