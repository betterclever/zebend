  +v4 = U32.mac64(2, a6, a7, 1, 0, 0, 2147483648, v3, 0)
  (1 - v4 : U32)

def zero() -> Fp:
  Fp{0, 0, 0, 0, 0, 0, 0, 0}

def one() -> Fp:
  Fp{38, 0, 0, 0, 0, 0, 0, 0}

# R^2 mod p: raw -> Montgomery
def R2() -> Fp:
  Fp{1444, 0, 0, 0, 0, 0, 0, 0}

# R^3 mod p: mul(R3(), x) = x * R^2 (for x * 2^256 in Montgomery form)
def R3() -> Fp:
  Fp{54872, 0, 0, 0, 0, 0, 0, 0}

def raw_one() -> Fp:
  Fp{1, 0, 0, 0, 0, 0, 0, 0}

def neg(a: Fp) -> Fp:
  sub(zero(), a)

def dbl(+a: Fp) -> Fp:
  add(a, a)

def is_eq(a: Fp, b: Fp) -> Bool:
  U32.is_eq(eq(a, b), 1)

def is_zero(a: Fp) -> Bool:
  U32.is_eq(eq(a, zero()), 1)

# raw words (ANY value < 2^256) -> Montgomery form, reduced mod p. R2 is the left operand
# (the one that must be < p; see gen_fields.py).
def from_raw(a: Fp) -> Fp:
  mul(R2(), a)

# Montgomery -> canonical raw words
def to_raw(a: Fp) -> Fp:
  mul(a, raw_one())

# low bit of the canonical value (Ed25519's 'is_negative')
def low_bit_raw(a: Fp) -> U32:
  Fp{+l0, _, _, _, _, _, _, _} = a
  (l0 .&. 1 : U32)

def low_bit(a: Fp) -> U32:
  low_bit_raw(to_raw(a))

def sqr_n(n: Nat, x: Fp) -> Fp:
  match n:
    case 0n:
      x
    case 1n+k:
      sqr_n(k, sqr(x))

type inv_T is Data:
  inv_T{x1: Fp, x3: Fp, x5: Fp, x7: Fp, x9: Fp, x11: Fp, x13: Fp, x15: Fp, x17: Fp, x19: Fp, x21: Fp, x23: Fp, x25: Fp, x27: Fp, x29: Fp, x31: Fp}

def inv_pre(+x: Fp) -> inv_T:
  +x1 = x
  +xx = sqr(x1)
  +x3 = mul(x1, xx)
  +x5 = mul(x3, xx)
  +x7 = mul(x5, xx)
  +x9 = mul(x7, xx)
  +x11 = mul(x9, xx)
  +x13 = mul(x11, xx)
  +x15 = mul(x13, xx)
  +x17 = mul(x15, xx)
  +x19 = mul(x17, xx)
  +x21 = mul(x19, xx)
  +x23 = mul(x21, xx)
  +x25 = mul(x23, xx)
  +x27 = mul(x25, xx)
  +x29 = mul(x27, xx)
  +x31 = mul(x29, xx)
  inv_T{x1, x3, x5, x7, x9, x11, x13, x15, x17, x19, x21, x23, x25, x27, x29, x31}

def inv_g1(t: inv_T) -> Fp:
  inv_T{+x1, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _} = t
  x1

def inv_g3(t: inv_T) -> Fp:
  inv_T{_, +x3, _, _, _, _, _, _, _, _, _, _, _, _, _, _} = t
  x3

