# 1 if a == b else 0 (branch-free).
def eq(a: Fp, b: Fp) -> U32:
  Fp{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7} = a
  Fp{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7} = b
  +v1 = ((a0 .^. b0) .|. (a1 .^. b1) .|. (a2 .^. b2) .|. (a3 .^. b3) .|. (a4 .^. b4) .|. (a5 .^. b5) .|. (a6 .^. b6) .|. (a7 .^. b7) : U32)
  +v2 = ((v1 .|. (0 - v1)) >> 31n : U32)
  (1 - v2 : U32)

# c == 1 selects a, c == 0 selects b (branch-free).
def sel(+c: U32, a: Fp, b: Fp) -> Fp:
  Fp{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7} = a
  Fp{+b0, +b1, +b2, +b3, +b4, +b5, +b6, +b7} = b
  +mk = (0 - c : U32)
  +nm = (mk .^. 4294967295 : U32)
  +v1 = ((a0 .&. mk) .|. (b0 .&. nm) : U32)
  +v2 = ((a1 .&. mk) .|. (b1 .&. nm) : U32)
  +v3 = ((a2 .&. mk) .|. (b2 .&. nm) : U32)
  +v4 = ((a3 .&. mk) .|. (b3 .&. nm) : U32)
  +v5 = ((a4 .&. mk) .|. (b4 .&. nm) : U32)
  +v6 = ((a5 .&. mk) .|. (b5 .&. nm) : U32)
  +v7 = ((a6 .&. mk) .|. (b6 .&. nm) : U32)
  +v8 = ((a7 .&. mk) .|. (b7 .&. nm) : U32)
  Fp{v1, v2, v3, v4, v5, v6, v7, v8}

# 1 if the raw 256-bit value a < modulus (canonical), else 0.
def lt_p(a: Fp) -> U32:
  Fp{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7} = a
  +v1 = U32.mac64(2, a0, a1, 1, 0, 18, 0, 1, 0)
