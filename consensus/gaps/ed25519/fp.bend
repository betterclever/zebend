  +a2 = mul(sqr_n(2n, a1), pow_p58_g1(t))
  a2

# x^((p-5)/8), for sqrt_ratio_i
def pow_p58(x: Fp) -> Fp:
  +t = pow_p58_pre(x)
  +r0 = pow_p58_g31(t)
  +r1 = pow_p58_c0(t, r0)
  +r2 = pow_p58_c1(t, r1)
  +r3 = pow_p58_c2(t, r2)
  +r4 = pow_p58_c3(t, r3)
  +r5 = pow_p58_c4(t, r4)
  r5
