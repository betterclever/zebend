def inv_c0(+t: inv_T, acc: Fp) -> Fp:
  +a0 = acc
  +a1 = mul(sqr_n(5n, a0), inv_g31(t))
  +a2 = mul(sqr_n(5n, a1), inv_g31(t))
  +a3 = mul(sqr_n(5n, a2), inv_g31(t))
  +a4 = mul(sqr_n(5n, a3), inv_g31(t))
  +a5 = mul(sqr_n(5n, a4), inv_g31(t))
  +a6 = mul(sqr_n(5n, a5), inv_g31(t))
  +a7 = mul(sqr_n(5n, a6), inv_g31(t))
  +a8 = mul(sqr_n(5n, a7), inv_g31(t))
  +a9 = mul(sqr_n(5n, a8), inv_g31(t))
  +a10 = mul(sqr_n(5n, a9), inv_g31(t))
  +a11 = mul(sqr_n(5n, a10), inv_g31(t))
  +a12 = mul(sqr_n(5n, a11), inv_g31(t))
  a12

def inv_c1(+t: inv_T, acc: Fp) -> Fp:
  +a0 = acc
  +a1 = mul(sqr_n(5n, a0), inv_g31(t))
  +a2 = mul(sqr_n(5n, a1), inv_g31(t))
  +a3 = mul(sqr_n(5n, a2), inv_g31(t))
  +a4 = mul(sqr_n(5n, a3), inv_g31(t))
  +a5 = mul(sqr_n(5n, a4), inv_g31(t))
  +a6 = mul(sqr_n(5n, a5), inv_g31(t))
  +a7 = mul(sqr_n(5n, a6), inv_g31(t))
  +a8 = mul(sqr_n(5n, a7), inv_g31(t))
  +a9 = mul(sqr_n(5n, a8), inv_g31(t))
  +a10 = mul(sqr_n(5n, a9), inv_g31(t))
  +a11 = mul(sqr_n(5n, a10), inv_g31(t))
  +a12 = mul(sqr_n(5n, a11), inv_g31(t))
  a12

def inv_c2(+t: inv_T, acc: Fp) -> Fp:
  +a0 = acc
  +a1 = mul(sqr_n(5n, a0), inv_g31(t))
  +a2 = mul(sqr_n(5n, a1), inv_g31(t))
  +a3 = mul(sqr_n(5n, a2), inv_g31(t))
  +a4 = mul(sqr_n(5n, a3), inv_g31(t))
  +a5 = mul(sqr_n(5n, a4), inv_g31(t))
  +a6 = mul(sqr_n(5n, a5), inv_g31(t))
  +a7 = mul(sqr_n(5n, a6), inv_g31(t))
  +a8 = mul(sqr_n(5n, a7), inv_g31(t))
  +a9 = mul(sqr_n(5n, a8), inv_g31(t))
  +a10 = mul(sqr_n(5n, a9), inv_g31(t))
  +a11 = mul(sqr_n(5n, a10), inv_g31(t))
  +a12 = mul(sqr_n(5n, a11), inv_g31(t))
  a12

def inv_c3(+t: inv_T, acc: Fp) -> Fp:
  +a0 = acc
  +a1 = mul(sqr_n(5n, a0), inv_g31(t))
  +a2 = mul(sqr_n(5n, a1), inv_g31(t))
  +a3 = mul(sqr_n(5n, a2), inv_g31(t))
  +a4 = mul(sqr_n(5n, a3), inv_g31(t))
  +a5 = mul(sqr_n(5n, a4), inv_g31(t))
  +a6 = mul(sqr_n(5n, a5), inv_g31(t))
  +a7 = mul(sqr_n(5n, a6), inv_g31(t))
  +a8 = mul(sqr_n(5n, a7), inv_g31(t))
  +a9 = mul(sqr_n(5n, a8), inv_g31(t))
  +a10 = mul(sqr_n(5n, a9), inv_g31(t))
  +a11 = mul(sqr_n(5n, a10), inv_g31(t))
  +a12 = mul(sqr_n(5n, a11), inv_g31(t))
  a12

def inv_c4(+t: inv_T, acc: Fp) -> Fp:
  +a0 = acc
  +a1 = mul(sqr_n(5n, a0), inv_g31(t))
  +a2 = mul(sqr_n(5n, a1), inv_g11(t))
  a2

# x^(p-2) = x^-1 (0 -> 0)
def inv(x: Fp) -> Fp:
  +t = inv_pre(x)
  +r0 = inv_g31(t)
  +r1 = inv_c0(t, r0)
  +r2 = inv_c1(t, r1)
  +r3 = inv_c2(t, r2)
  +r4 = inv_c3(t, r3)
  +r5 = inv_c4(t, r4)
  r5

type pow_p58_T is Data:
  pow_p58_T{x1: Fp, x3: Fp, x5: Fp, x7: Fp, x9: Fp, x11: Fp, x13: Fp, x15: Fp, x17: Fp, x19: Fp, x21: Fp, x23: Fp, x25: Fp, x27: Fp, x29: Fp, x31: Fp}

