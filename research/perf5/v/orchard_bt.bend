def ex_loop(aes: +List<+List<Fp.Fp>>, ies: +List<+List<Fp.Fp>>, pes: +List<+List<Fp.Fp>>, les: +List<+List<Fp.Fp>>, +theta: L.BF, +beta: L.BF, +gamma: L.BF, +x: L.BF, +y: L.BF, +l_0: L.BF, +l_last: L.BF, +active: L.BF, +fe: +List<Fp.Fp>, +pcv: +List<Fp.Fp>, +h: L.BF, +st: L.St) -> L.HS:
  match aes ies pes les:
    case Con{+ae, ar} Con{+ie, ir} Con{+pe, pr} Con{+le, lr}:
      +r = pp_expr(theta, beta, gamma, x, y, l_0, l_last, active, fe, pcv, ae, ie, pe, le, h, st)
      ex_loop(ar, ir, pr, lr, theta, beta, gamma, x, y, l_0, l_last, active, fe, pcv, L.hs_h(r), L.hs_st(r))
    case _ _ _ _:
      L.HS{h, st}

