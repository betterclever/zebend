def qa_loop(aes: +List<+List<Fp.Fp>>, ies: +List<+List<Fp.Fp>>, pes: +List<+List<Fp.Fp>>, les: +List<+List<Fp.Fp>>, aps: +List<+List<V.Pt>>, lps: +List<+List<V.Pt>>, pps: +List<+List<V.Pt>>, kps: +List<+List<V.Pt>>, ics: +List<V.Pt>, +x1: L.BF, +q: QA) -> QA:
