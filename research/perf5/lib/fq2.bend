# (pow_t x, pow_t y)
def pow_t2(+x: Fq2) -> Fq2:
  +s10 = sqr2(x)
  +s11 = mul2(s10, x)
  +s110 = sqr2(s11)
  +s111 = mul2(s110, x)
  +s1001 = mul2(s111, s10)
  +s1011 = mul2(s1001, s10)
  +s1101 = mul2(s1011, s10)
  +a0 = mul2(sqr_n2(129n, x), x)
  +a1 = mul2(sqr_n2(7n, a0), s1001)
  +a2 = mul2(sqr_n2(7n, a1), s1101)
  +a3 = mul2(sqr_n2(4n, a2), s11)
  +a4 = mul2(sqr_n2(6n, a3), s111)
  +a5 = mul2(sqr_n2(3n, a4), s111)
  +a6 = mul2(sqr_n2(10n, a5), s1001)
  +a7 = mul2(sqr_n2(4n, a6), s1001)
  +a8 = mul2(sqr_n2(5n, a7), s1001)
  +a9 = mul2(sqr_n2(5n, a8), s1001)
  +a10 = mul2(sqr_n2(3n, a9), s1001)
  +a11 = mul2(sqr_n2(4n, a10), s1011)
  +a12 = mul2(sqr_n2(4n, a11), s1011)
  +a13 = mul2(sqr_n2(5n, a12), s11)
  +a14 = mul2(sqr_n2(4n, a13), x)
  +a15 = mul2(sqr_n2(5n, a14), s11)
  +a16 = mul2(sqr_n2(4n, a15), s111)
  +a17 = mul2(sqr_n2(5n, a16), s1011)
  +a18 = mul2(sqr_n2(3n, a17), x)
  sqr_n2(4n, a18)

def root2_fin(p: Fq2, v: Fq2) -> Fq2:
  Fq2{+x, +y} = p
  Fq2{+vx, +vy} = v
  Fq2{SQ.common(B.mul(x, vx), vx), SQ.common(B.mul(y, vy), vy)}

# (SQ.root x, SQ.root y)
def root2(+p: Fq2) -> Fq2:
  root2_fin(p, pow_t2(p))

type D2 is Data:
  D2{a: VD.Dec, b: VD.Dec}

def dec2_fin(+x1: B.Fq, +s1: U32, +c1: U32, +r1: B.Fq, +x2: B.Fq, +s2: U32, +c2: U32, +r2: B.Fq, y: Fq2) -> D2:
  Fq2{+y1, +y2} = y
  D2{VD.dec_ct_fin(x1, s1, c1, y1, SQ.is_root(y1, r1)), VD.dec_ct_fin(x2, s2, c2, y2, SQ.is_root(y2, r2))}

def dec2_x(+x1: B.Fq, +s1: U32, +c1: U32, +x2: B.Fq, +s2: U32, +c2: U32) -> D2:
  +r1 = VD.rhs(x1)
  +r2 = VD.rhs(x2)
  dec2_fin(x1, s1, c1, r1, x2, s2, c2, r2, root2(Fq2{r1, r2}))

# (VD.decompress_ct w1, VD.decompress_ct w2)
def decompress2(+w1: Wd.W, +w2: Wd.W) -> D2:
  +xw1 = Wd.clear_top_bit(w1)
  +xw2 = Wd.clear_top_bit(w2)
  dec2_x(B.from_words(xw1), Wd.top_bit(w1), Bool.to_u32(Wd.is_lt(xw1, B.modulus())), B.from_words(xw2), Wd.top_bit(w2), Bool.to_u32(Wd.is_lt(xw2, B.modulus())))
