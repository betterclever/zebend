import Base
import ./zcrypto.bend as Z

def chk(name: String, +a: Z.F, +b: Z.F) -> String:
  name ++ "=" ++ U32.show(Z.fis_eq(a, b)) ++ " "

def main() -> IO(Unit):
  do IO<Unit>:
    IO.print(chk("mul0", Z.from_mont(Z.fmul(Z.to_mont(Z.F{54562, 45351, 17264, 22017, 42209, 39932, 25940, 8430, 37729, 12889, 37234, 15393, 56115, 60696, 53241, 9486}), Z.to_mont(Z.F{12869, 1086, 13998, 55975, 36296, 37122, 173, 40844, 15926, 64307, 23879, 36228, 870, 6898, 6061, 16301}))), Z.F{21968, 33503, 51915, 31675, 32094, 27947, 9563, 13742, 59432, 6276, 16232, 1509, 45147, 18059, 26522, 7642}) ++ chk("add0", Z.from_mont(Z.fadd(Z.to_mont(Z.F{54562, 45351, 17264, 22017, 42209, 39932, 25940, 8430, 37729, 12889, 37234, 15393, 56115, 60696, 53241, 9486}), Z.to_mont(Z.F{12869, 1086, 13998, 55975, 36296, 37122, 173, 40844, 15926, 64307, 23879, 36228, 870, 6898, 6061, 16301}))), Z.F{1894, 46438, 18737, 38779, 14734, 9138, 52486, 40499, 53655, 11660, 61114, 51621, 56985, 2058, 59303, 9403}) ++ chk("sub0", Z.from_mont(Z.fsub(Z.to_mont(Z.F{54562, 45351, 17264, 22017, 42209, 39932, 25940, 8430, 37729, 12889, 37234, 15393, 56115, 60696, 53241, 9486}), Z.to_mont(Z.F{12869, 1086, 13998, 55975, 36296, 37122, 173, 40844, 15926, 64307, 23879, 36228, 870, 6898, 6061, 16301}))), Z.F{41694, 44265, 15791, 5255, 4148, 5191, 64931, 41896, 21802, 14118, 13354, 44701, 55244, 53798, 47180, 9569}) ++ chk("inv0", Z.from_mont(Z.finv(Z.to_mont(Z.F{54562, 45351, 17264, 22017, 42209, 39932, 25940, 8430, 37729, 12889, 37234, 15393, 56115, 60696, 53241, 9486}))), Z.F{51781, 41223, 10421, 51157, 9523, 64721, 41306, 37903, 46760, 9501, 16559, 30732, 15209, 23297, 53021, 9142}) ++ chk("mul1", Z.from_mont(Z.fmul(Z.to_mont(Z.F{37225, 5932, 24670, 13790, 39398, 38210, 61341, 60662, 30511, 21846, 46353, 31466, 23473, 43108, 31926, 8999}), Z.to_mont(Z.F{33619, 5224, 56444, 21633, 51046, 53965, 21447, 29285, 877, 11128, 59153, 64217, 44228, 15193, 25788, 16019}))), Z.F{16687, 23639, 47645, 28130, 22266, 25065, 5495, 56161, 22673, 59120, 18963, 29628, 47151, 8044, 7210, 14712}) ++ chk("add1", Z.from_mont(Z.fadd(Z.to_mont(Z.F{37225, 5932, 24670, 13790, 39398, 38210, 61341, 60662, 30511, 21846, 46353, 3