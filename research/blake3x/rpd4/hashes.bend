def b2_fin(h: BH, st: B16) -> BH:
  BH{h0l, h0h, h1l, h1h, h2l, h2h, h3l, h3h, h4l, h4h, h5l, h5h, h6l, h6h, h7l, h7h} = h
  B16{v0l, v0h, v1l, v1h, v2l, v2h, v3l, v3h, v4l, v4h, v5l, v5h, v6l, v6h, v7l, v7h, v8l, v8h, v9l, v9h, v10l, v10h, v11l, v11h, v12l, v12h, v13l, v13h, v14l, v14h, v15l, v15h} = st
  BH{(h0l .^. v0l .^. v8l : U32), (h0h .^. v0h .^. v8h : U32), (h1l .^. v1l .^. v9l : U32), (h1h .^. v1h .^. v9h : U32), (h2l .^. v2l .^. v10l : U32), (h2h .^. v2h .^. v10h : U32), (h3l .^. v3l .^. v11l : U32), (h3h .^. v3h .^. v11h : U32), (h4l .^. v4l .^. v12l : U32), (h4h .^. v4h .^. v12h : U32), (h5l .^. v5l .^. v13l : U32), (h5h .^. v5h .^. v13h : U32), (h6l .^. v6l .^. v14l : U32), (h6h .^. v6h .^. v14h : U32), (h7l .^. v7l .^. v15l : U32), (h7h .^. v7h .^. v15h : U32)}

# BLAKE2b compression F(h, m, t, f): t = byte counter (< 2^32 here), last = 0xFFFFFFFF on the final block.
def b2_compress(+h: BH, +m: BM, +t: U32, +last: U32) -> BH:
  b2_fin(h, b2_mix(h, m, t, last))

def b2_leaf_mix(+h: BH, +m0l: U32, +m0h: U32, +m1l: U32, +m1h: U32) -> B16:
  BH{+h0l, +h0h, +h1l, +h1h, +h2l, +h2h, +h3l, +h3h, +h4l, +h4h, +h5l, +h5h, +h6l, +h6h, +h7l, +h7h} = h
  b2l_g2(b2l_g1(b2l_g0(B16{h0l, h0h, h1l, h1h, h2l, h2h, h3l, h3h, h4l, h4h, h5l, h5h, h6l, h6h, h7l, h7h, 4089235720, 1779033703, 2227873595, 3144134277, 4271175723, 1013904242, 1595750129, 2773480762, 2917564993, 1359893119, 725511199, 2600822924, 79577748, 3766232660, 327033209, 1541459225}, m0l, m0h, m1l, m1h), m0l, m0h, m1l, m1h), m0l, m0h, m1l, m1h)

# b2_compress(h, BM{m0l, m0h, m1l, m1h, 0, ..., 0}, 144, 0xFFFFFFFF): the final block of an
# Equihash leaf hash, with the 14 zero message words and the constants folded away.
def b2_leaf(+h: BH, +m0l: U32, +m0h: U32, +m1l: U32, +m1h: U32) -> BH:
  b2_fin(h, b2_leaf_mix(h, m0l, m0h, m1l, m1h))

