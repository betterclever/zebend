# GENERATED by research/decomp/gen.py from pallas_dec.bend. Do not edit.
# Vesta point decompression with the table square root. Drop-in for crypto/field3/lib64/vesta.bend's
# decompress (same results; pasta_curves from_bytes semantics: rejects a non-canonical x and
# non-points; x = 0 with a clear sign bit is the identity), plus a fixed-work variant.
import Base
import ../../zcash/halo2/lib/words.bend as Wd
import ../../crypto/field3/fq64.bend as B
import ../../crypto/field3/lib64/vesta.bend as P
import ./fq_sqrt.bend as SQ

# y^2 = x^3 + 5
def rhs(+x: B.Fq) -> B.Fq:
  B.add(B.mul(B.sqr(x), x), B.from_u32(5))

def dec_y(+x: B.Fq, +ysign: U32, my: Maybe<&2, B.Fq>) -> Maybe<&2, P.Pt>:
  match my:
    case None{}:
      None{}
    case Some{+y}:
      Some{P.Pt{x, B.sel((B.low_bit(y) .^. ysign : U32), B.neg(y), y), B.one()}}

# x = 0: the identity if the sign bit is clear; otherwise y^2 = 5, which has no solution.
def dec_y0(b: Bool) -> Maybe<&2, P.Pt>:
  match b:
    case True{}:
      Some{P.identity()}
    case False{}:
      None{}

def dec_xz(z: Bool, +x: B.Fq, +ysign: U32) -> Maybe<&2, P.Pt>:
  match z:
    case True{}:
      dec_y0(U32.is_eq(ysign, 0))
    case False{}:
      dec_y(x, ysign, SQ.sqrt(rhs(x)))

# Early rejection: a non-canonical x costs one comparison, no square root.
def dec_x(+x: B.Fq, +ysign: U32, canon: Bool) -> Maybe<&2, P.Pt>:
  match canon:
    case False{}:
      None{}
    case True{}:
      dec_xz(B.is_zero(x), x, ysign)

def decompress(+w: Wd.W) -> Maybe<&2, P.Pt>:
  +xw = Wd.clear_top_bit(w)
  dec_x(B.from_words(xw), Wd.top_bit(w), Wd.is_lt(xw, B.modulus()))

# Fixed-work form for GPU lanes: always one square root, no data-dependent branches.
# ok = 1 iff decompress(w) is Some; p is then that point (the identity for x = 0, sign 0).
type Dec is Data:
  Dec{ok: U32, p: P.Pt}

def dec_ct_fin(+x: B.Fq, +ysign: U32, +canon: U32, +y: B.Fq, +sq: U32) -> Dec:
  +xz = B.eq(x, B.zero())
  +ok = (canon .&. ((xz .&. (ysign .^. 1 : U32)) .|. ((xz .^. 1 : U32) .&. sq)) : U32)
  +yy = B.sel((B.low_bit(y) .^. ysign : U32), B.neg(y), y)
  Dec{ok, P.Pt{x, B.sel(xz, B.one(), yy), B.sel(xz, B.zero(), B.one())}}

def dec_ct_y(+x: B.Fq, +ysign: U32, +canon: U32, +r: B.Fq) -> Dec:
  +y = SQ.root(r)
  dec_ct_fin(x, ysign, canon, y, SQ.is_root(y, r))

def decompress_ct(+w: Wd.W) -> Dec:
  +xw = Wd.clear_top_bit(w)
  +x = B.from_words(xw)
  dec_ct_y(x, Wd.top_bit(w), Bool.to_u32(Wd.is_lt(xw, B.modulus())), rhs(x))

def mk_maybe(ok: U32, p: P.Pt) -> Maybe<&2, P.Pt>:
  match ok:
    case 1:
      Some{p}
    case _:
      None{}
